var array<int> m5Times = array.new_int(34, 0)
var array<int> m5PivotTimes = array.new_int(34, na)
var array<int> qaObservedDirectionBySlot = array.new_int(34, 0)
var array<int> qaSourcePhaseBySlot = array.new_int(34, na)
var array<int> m15Times = array.new_int(34, 0)
// V34.10u — Telemetria por feed usando el MISMO Signal del
// escaner. Solo se ve en la vista opt-in; no entra en alertas.
var array<int> auditFeedAvailable = array.new_int(34, 0)
var array<int> auditFeedC1 = array.new_int(34, 0)
var array<int> auditFeedH4Closed = array.new_int(34, 0)
var array<int> auditFeedC1Hours = array.new_int(34, 0)
var array<int> auditFeedC1Clock = array.new_int(34, 0)
var array<int> auditFeedC1Data = array.new_int(34, 0)
var array<int> auditFeedC1Range = array.new_int(34, 0)
var array<int> auditFeed2C = array.new_int(34, 0)
var array<int> auditFeed3C = array.new_int(34, 0)
var array<int> auditFeedInside = array.new_int(34, 0)
var array<int> auditFeedM4 = array.new_int(34, 0)
var array<int> auditFeedMN = array.new_int(34, 0)
var array<int> auditFeedH4StartMis = array.new_int(34, 0)
var array<int> auditFeedH4EndMis = array.new_int(34, 0)
var array<int> auditFeedH4BarsMis = array.new_int(34, 0)
var array<int> auditFeedPhaseMin = array.new_int(34, na)
var array<int> auditFeedH4LastBars = array.new_int(34, na)
var array<int> auditFeedH4StartShift = array.new_int(34, na)
var array<int> auditFeedH4EndShift = array.new_int(34, na)
var array<int> auditFeedH4Gap = array.new_int(34, 0)
var array<int> auditFeedH4DST = array.new_int(34, 0)
var array<int> auditFeedH4Session = array.new_int(34, 0)
var array<int> auditFeedH4Internal = array.new_int(34, 0)
var array<int> auditFeedC2Rejected = array.new_int(34, 0)
var array<int> auditFeedM15QA = array.new_int(34, 0)
var array<string> pdhTexts = array.new_string(34, "N/D")
var array<string> pdlTexts = array.new_string(34, "N/D")
var array<int> pdhFlags = array.new_int(34, -1)
var array<int> pdlFlags = array.new_int(34, -1)
int found = 0
int foundQA = 0
int with5 = 0
int with15 = 0
int missing = 0
int checked = 0
// Conteos historicos agregados de los feeds M5 realmente consultados.
int hist2C34 = 0
int hist3C34 = 0
int histInside34 = 0
int histM434 = 0
int histMN34 = 0
int withHistory34 = 0
int familyQA15Count = 0

for i = 0 to 33
    string candidateSymbol = array.get(scanSymbols, i)
    if chartIsIC and ticker.standard(candidateSymbol) == integratedChartBroker
        chartStaticSlot := i
    if scanAll or i == 7
        string symbol = candidateSymbol
        // El UDT cuenta como un campo de retorno, evita 34*12 campos de tupla.
        Signal s = request.security(symbol, "5", f_engine_snapshot(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=600)
        bool available = not na(s) and not na(s.phase)
        if available and chartIsIC and ticker.standard(symbol) == integratedChartBroker
            integratedOwn := s
            integratedSlot := i
        int st = available ? s.phase : 0
        int dr = available ? s.direction : 0
        int id = available and not na(s.c1Start) ? s.c1Start : 0
        int m5t = available and not na(s.m5At) ? s.m5At : 0
        int m15t = available and not na(s.m15At) ? s.m15At : 0
        bool structuralCoreObserved = available and st == 2 and s.isPatternValid and s.modelKind == "CRT_2C_RETURN" and id > 0 and (dr == 1 or dr == -1) and not na(s.sweepAt) and s.sweepAt > s.crtC2Start and not na(s.crtC2Start) and not na(s.crtRatifiedAt) and s.crtRatifiedAt >= s.crtC2Start + H4MS
        // Preserve prior validation gate. Only non-core, exact H4 ratified
        // sources are eligible to have their own MSS evidence shown as QA.
        bool scanCrtValid = structuralCoreObserved and (not qaPhase1NonBtc or i == 7)
        bool observedCoreQA = structuralCoreObserved and not scanCrtValid
        bool ownCoreC1Ready = structuralCoreObserved and not na(s.crh) and not na(s.crl) and s.crh > s.crl
        bool ownOtherC1Ready = available and not na(s.familyVisual) and s.familyVisual.structuralQA and not na(s.familyVisual.c1Start) and not na(s.familyVisual.c1High) and not na(s.familyVisual.c1Low) and s.familyVisual.c1High > s.familyVisual.c1Low and not na(s.familyVisual.eventClosedAt) and s.familyVisual.eventClosedAt >= s.familyVisual.c1Start and s.familyVisual.direction != 0
        array.set(qaCoreC1ReadyBySlot,i,ownCoreC1Ready)
        array.set(qaOtherC1ReadyBySlot,i,ownOtherC1Ready)
        array.set(qaOtherC1KindBySlot,i,ownOtherC1Ready ? s.familyVisual.kind : "NONE")
        array.set(qaCatalogPerFeed, i, available ? nz(s.qaCatalogMask, 0) : 0)
        array.set(qaC1BySlot, i, available ? s.c1Start : na)
        array.set(qaC2BySlot, i, available ? s.crtC2Start : na)
        array.set(qaSweepBySlot, i, available ? s.sweepAt : na)
        array.set(qaRatBySlot, i, available ? s.crtRatifiedAt : na)
        array.set(qaPivot15AtBySlot, i, available ? s.m15PivotAt : na)
        array.set(qaPivot15PriceBySlot, i, available ? s.m15Level : na)
        array.set(qaBreak15BySlot, i, available ? s.m15At : na)
        array.set(qaClosed15BySlot, i, available ? s.qaLastClosedM15At : na)
        array.set(qaExtraKindBySlot, i, available ? s.extraFamilyKind : "NONE")
        array.set(qaExtraC1BySlot, i, available ? s.extraFamilyC1 : na)
        array.set(qaExtraSweepBySlot, i, available ? s.extraFamilySweepAt : na)
        array.set(qaExtraPivot15AtBySlot, i, available ? s.extraFamilyM15PivotAt : na)
        array.set(qaExtraPivot15PriceBySlot, i, available ? s.extraFamilyM15Pivot : na)
        array.set(qaExtraBreak15BySlot, i, available ? s.extraFamilyM15At : na)
        array.set(qaExtraRatBySlot, i, available ? s.extraFamilyRatifiedAt : na)
        array.set(qaHistCandidate2CBySlot, i, available ? s.qaLastCandidate2CAt : na)
        array.set(qaHistRatified2CBySlot, i, available ? s.qaLastRatified2CAt : na)
        array.set(qaHistRejectedExpansionBySlot, i, available ? s.qaLastRejectedExpansionAt : na)
        array.set(qaHistConfirmed3CBySlot, i, available ? s.qaLastConfirmed3CAt : na)
        array.set(qaTrue3CSignedBySlot, i, available ? s.qaTrue3CSignedAt : na)
        array.set(qaHistInsideReturnBySlot, i, available ? s.qaLastInsideReturnAt : na)
        array.set(qaHistInsideContinuationBySlot, i, available ? s.qaLastInsideContinuationAt : na)
        array.set(qaHistMulti4BySlot, i, available ? s.qaLastMulti4At : na)
        array.set(qaHistMultiNBySlot, i, available ? s.qaLastMultiNAt : na)
        array.set(qaHistRetest15BySlot, i, available ? s.qaLastRetest15At : na)
        array.set(statuses, i, st)
        bool extraValidQA = available and s.extraFamilyValid and not na(s.extraFamilyC1) and s.extraFamilyC1 > 0 and not na(s.extraFamilyRatifiedAt) and (s.extraFamilyDirection == 1 or s.extraFamilyDirection == -1) and (s.extraFamilyKind == "INSIDE QA" or s.extraFamilyKind == "MULTI4 QA" or s.extraFamilyKind == "MULTI-N QA" or s.extraFamilyKind == "3C TRUE QA")
        bool anyStructuralCRT = scanCrtValid or extraValidQA
        array.set(validCrtFlags, i, anyStructuralCRT)
        array.set(validCoreFlags, i, scanCrtValid)
        array.set(qaCoreObservedFlags, i, observedCoreQA)
        array.set(familyLabels, i, scanCrtValid ? "3C" : extraValidQA ? s.extraFamilyKind : "NONE")
        array.set(directions, i, scanCrtValid ? dr : extraValidQA ? s.extraFamilyDirection : 0)
        array.set(c1IDs, i, id)
        array.set(m5Flags, i, m5t > 0 ? 1 : 0)
        array.set(m15Flags, i, m15t > 0 ? 1 : 0)
        bool family15QA = extraValidQA and not na(s.extraFamilyC1) and s.extraFamilyM15C1 == s.extraFamilyC1 and not na(s.extraFamilySweepAt) and not na(s.extraFamilyM15PivotAt) and s.extraFamilyM15PivotAt < s.extraFamilySweepAt and not na(s.extraFamilyM15Pivot) and not na(s.extraFamilyM15At) and s.extraFamilyM15At > s.extraFamilySweepAt and f_m15_phase_ok(s.extraFamilyM15At, s.qaSourcePhaseMin) and not na(s.qaLastClosedM15At) and s.extraFamilyM15At <= s.qaLastClosedM15At
        array.set(extraM15Flags, i, family15QA ? 1 : 0)
        bool family5QA = extraValidQA and not na(s.extraFamilyC1) and s.extraFamilyM5C1 == s.extraFamilyC1 and not na(s.extraFamilySweepAt) and not na(s.extraFamilyM5Pivot) and not na(s.extraFamilyM5PivotAt) and s.extraFamilyM5PivotAt < s.extraFamilySweepAt and not na(s.extraFamilyM5At) and s.extraFamilyM5At > s.extraFamilySweepAt and not na(s.qaSourcePhaseMin) and s.extraFamilyM5At % MIN5 == s.qaSourcePhaseMin * 60000
        array.set(extraM5Flags, i, family5QA ? 1 : 0)
        array.set(m5Times, i, m5t)
        array.set(m5PivotTimes, i, available ? s.m5PivotAt : na)
        array.set(qaObservedDirectionBySlot, i, available ? dr : 0)
        array.set(qaSourcePhaseBySlot, i, available ? s.qaSourcePhaseMin : na)
        array.set(m15Times, i, m15t)
        string hStatus = available ? s.pdhStatus : "N/D"
        string lStatus = available ? s.pdlStatus : "N/D"
        array.set(pdhFlags, i, hStatus == "N/D" ? -1 : hStatus == "TAKEN" ? 1 : 0)
        array.set(pdlFlags, i, lStatus == "N/D" ? -1 : lStatus == "TAKEN" ? 1 : 0)
        array.set(pdhTexts, i, available ? f_liqText(hStatus, s.pdhSweepAt, s.pdhSweepStage, s.pdhSweepC1, s.c1Start, s.crtC2Start) : "N/D")
        array.set(pdlTexts, i, available ? f_liqText(lStatus, s.pdlSweepAt, s.pdlSweepStage, s.pdlSweepC1, s.c1Start, s.crtC2Start) : "N/D")
        // Identidad del SLOT de feed. Conteos de historial LIMITADO:
        // QA memoria: calc_bars_count=600 M5 por fuente. Verificar completitud por broker/calendario.
        array.set(auditFeedAvailable, i, available ? 1 : 0)
        array.set(auditFeedC1, i, available ? nz(s.qaC1Ready, 0) : 0)
        array.set(auditFeedH4Closed, i, available ? nz(s.auditC1H4Closed, 0) : 0)
        array.set(auditFeedC1Hours, i, available ? nz(s.auditC1HourCandidates, 0) : 0)
        array.set(auditFeedC1Clock, i, available ? nz(s.auditC1BadClock, 0) : 0)
        array.set(auditFeedC1Data, i, available ? nz(s.auditC1BadData, 0) : 0)
        array.set(auditFeedC1Range, i, available ? nz(s.auditC1BadRange, 0) : 0)
        array.set(auditFeed2C, i, available ? nz(s.audit2C, 0) : 0)
        array.set(auditFeed3C, i, available ? nz(s.audit3C, 0) : 0)
        array.set(auditFeedInside, i, available ? nz(s.auditInside, 0) : 0)
        array.set(auditFeedM4, i, available ? nz(s.auditM4, 0) : 0)
        array.set(auditFeedMN, i, available ? nz(s.auditMN, 0) : 0)
        array.set(auditFeedH4StartMis, i, available ? nz(s.qaH4BadStart, 0) : 0)
        array.set(auditFeedH4EndMis, i, available ? nz(s.qaH4BadEnd, 0) : 0)
        array.set(auditFeedH4BarsMis, i, available ? nz(s.qaH4BadBars, 0) : 0)
        array.set(auditFeedPhaseMin, i, available ? s.qaLastM5PhaseMin : na)
        array.set(auditFeedH4LastBars, i, available ? s.qaH4LastBars : na)
        array.set(auditFeedH4StartShift, i, available ? s.qaH4LastStartOffsetMin : na)
        array.set(auditFeedH4EndShift, i, available ? s.qaH4LastEndOffsetMin : na)
        array.set(auditFeedH4Gap, i, available ? nz(s.auditH4Incomplete, 0) : 0)
        array.set(auditFeedH4DST, i, available ? nz(s.auditH4DST, 0) : 0)
        array.set(auditFeedH4Session, i, available ? nz(s.auditH4Session, 0) : 0)
        array.set(auditFeedH4Internal, i, available ? nz(s.auditH4Internal, 0) : 0)
        int c2RejectSum = available ? nz(s.auditC2Data, 0) + nz(s.auditC2Double, 0) + nz(s.auditC2NoSweep, 0) + nz(s.auditC2Outside, 0) + nz(s.auditC2Hour, 0) : 0
        array.set(auditFeedC2Rejected, i, c2RejectSum)
        array.set(auditFeedM15QA, i, family15QA ? 1 : 0)
        if not available
            missing += 1
        else
            checked += 1
            int h2 = nz(s.audit2C, 0)
            int h3 = nz(s.audit3C, 0)
            int hi = nz(s.auditInside, 0)
            int hm4 = nz(s.auditM4, 0)
            int hmn = nz(s.auditMN, 0)
            hist2C34 += h2
            hist3C34 += h3
            histInside34 += hi
            histM434 += hm4
            histMN34 += hmn
            if h2 + h3 + hi + hm4 + hmn > 0
                withHistory34 += 1
            if family15QA
                familyQA15Count += 1
        if scanCrtValid
            found += 1
        if extraValidQA and not scanCrtValid
            foundQA += 1
        if scanCrtValid
            if m5t > 0
                with5 += 1
            if m15t > 0
                with15 += 1
// External alerts remain disabled; the 34-market monitor is QA only.


 // Two-slot Basic edition A: scan all 34 symbols; same full CRT/MSS engine.
var table board = table.new(position.top_right,6,15,frame_color=color.new(color.gray,70),frame_width=1,border_width=0)
color navy = color.rgb(24,36,56)
color shade = color.rgb(33,44,62)
color posInk = color.rgb(65,190,138)
color negInk = color.rgb(240,113,108)
plot(checked, title="QORE QA fuentes respondidas", display=display.data_window)
// Closed MSS evidence from the SAME symbol and 2C-C1 cycle, not another
// timeframe or the previously saved MSS of a different model.
f_monitorOwnMss(int slot) =>
    bool coreOrQa = array.get(validCoreFlags,slot) or array.get(qaCoreObservedFlags,slot)
    int c1T = array.get(qaC1BySlot,slot)
    int sweepT = array.get(qaSweepBySlot,slot)
    int ratT = array.get(qaRatBySlot,slot)
    int p5 = array.get(m5PivotTimes,slot)
    int b5 = array.get(m5Times,slot)
    int p15 = array.get(qaPivot15AtBySlot,slot)
    int b15 = array.get(m15Times,slot)
    int lastClosed15 = array.get(qaClosed15BySlot,slot)
    int phase = array.get(qaSourcePhaseBySlot,slot)
    bool cycleRoot = coreOrQa and not na(c1T) and not na(sweepT) and not na(ratT) and sweepT > c1T and ratT >= sweepT
    bool phaseOK = not na(phase) and phase >= 0 and phase <= 4
    bool m5Confirmed = cycleRoot and phaseOK and not na(p5) and p5 < sweepT and b5 > sweepT and b5 % MIN5 == phase * 60000
    bool m15Confirmed = cycleRoot and phaseOK and not na(p15) and p15 < sweepT and b15 > sweepT and not na(lastClosed15) and b15 <= lastClosed15 and f_m15_phase_ok(b15,phase)
    [m5Confirmed,m15Confirmed]


// QA 34x5 historical family matrix. These are CLOSED events retained by
// this feed's 600-bar M5 lookback; never current CRT or valid MSS.
f_qaHistoryDate(int t) =>
    na(t) or t <= 0 ? "—" : str.format_time(t, "dd/MM", "Etc/UTC")

f_qaHistoryMin(int t) =>
    na(t) or t <= 0 ? "N/D" : str.tostring(int(math.floor(t / 60000)))

f_renderFamilyHistory() =>
    if barstate.islast and showDashboard and qaFamilyHistoryView
        table.clear(board,0,0,5,14)
        table.cell(board,0,0,"MERCADO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,0,"2C H",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,0,"3C H",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,0,"INS H",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,0,"M4 H",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,0,"MN H",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        int nFeeds = scanAll ? 34 : 1
        int onPage = 10
        int totalPages = math.max(1,int(math.ceil(nFeeds * 1.0 / onPage)))
        int pageNow = math.min(math.max(page,1),totalPages)
        int count2C = 0
        int countTrue3C = 0
        int countInside = 0
        int countM4 = 0
        int countMN = 0
        int exact3cInsideCloses = 0
        for i = 0 to 33
            if scanAll or i == 7
                int c2 = array.get(qaHistRatified2CBySlot,i)
                // Use ONLY the distinct signed true3C closed-C3 event. The
                // legacy qaLastConfirmed3CAt means a 2C distributing in C3.
                int true3cSigned = array.get(qaTrue3CSignedBySlot,i)
                int true3c = na(true3cSigned) ? na : int(math.abs(true3cSigned))
                int inside = array.get(qaHistInsideReturnBySlot,i)
                int multi4 = array.get(qaHistMulti4BySlot,i)
                int multin = array.get(qaHistMultiNBySlot,i)
                // Exact same CLOSED H4 end, not same calendar date.
                // Coincidence is diagnostic only; C1 geometry may differ.
                bool closeOverlap = not na(true3c) and not na(inside) and true3c == inside
                if closeOverlap
                    exact3cInsideCloses += 1
                if not na(c2) and c2 > 0
                    count2C += 1
                if not na(true3c) and true3c > 0
                    countTrue3C += 1
                if not na(inside) and inside > 0
                    countInside += 1
                if not na(multi4) and multi4 > 0
                    countM4 += 1
                if not na(multin) and multin > 0
                    countMN += 1
                int ordinal = scanAll ? i : 0
                int rowIndex = ordinal - (pageNow - 1) * onPage + 1
                if rowIndex >= 1 and rowIndex <= onPage
                    color bg = rowIndex % 2 == 0 ? shade : navy
                    // The * is an overlap of LAST closed-event times, not
                    // a second CRT, MSS proof, or verified common C1.
                    string collisionTag = closeOverlap ? "*" : ""
                    table.cell(board,0,rowIndex,array.get(scanNames,i) + collisionTag,bgcolor=bg,text_color=closeOverlap ? color.orange : color.white,text_size=size.tiny)
                    table.cell(board,1,rowIndex,f_qaHistoryDate(c2),bgcolor=bg,text_color=color.gray,text_size=size.tiny)
                    table.cell(board,2,rowIndex,f_qaHistoryDate(true3c) + collisionTag,bgcolor=bg,text_color=color.orange,text_size=size.tiny)
                    table.cell(board,3,rowIndex,f_qaHistoryDate(inside) + collisionTag,bgcolor=bg,text_color=color.orange,text_size=size.tiny)
                    table.cell(board,4,rowIndex,f_qaHistoryDate(multi4),bgcolor=bg,text_color=color.orange,text_size=size.tiny)
                    table.cell(board,5,rowIndex,f_qaHistoryDate(multin),bgcolor=bg,text_color=color.orange,text_size=size.tiny)
        table.cell(board,0,11,"P "+str.tostring(pageNow)+"/"+str.tostring(totalPages),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,1,11,"2C:"+str.tostring(count2C),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,11,"3C:"+str.tostring(countTrue3C),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,11,"INS:"+str.tostring(countInside),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,4,11,"M4:"+str.tostring(countM4),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,5,11,"MN:"+str.tostring(countMN),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        int selected = math.min(math.max(qaEventSlot - 1,0),33)
        if not scanAll
            selected := 7
        else if qaHistoryFollowChart
            selected := -1
            string selectedBrokerSymbol = ticker.standard(syminfo.tickerid)
            for slot = 0 to 33
                if ticker.standard(array.get(scanSymbols,slot)) == selectedBrokerSymbol
                    selected := slot
                    break
        // No fallback to AUDJPY/S1 when GBP/AUD is opened in a
        // different broker. Last-event timestamps must NEVER cross feeds.
        bool selectedReady = selected >= 0
        int selected3cs = selectedReady ? array.get(qaTrue3CSignedBySlot,selected) : na
        int selected3c = na(selected3cs) ? na : int(math.abs(selected3cs))
        int selectedInside = selectedReady ? array.get(qaHistInsideReturnBySlot,selected) : na
        bool same3cInsideClose = not na(selected3c) and not na(selectedInside) and selected3c == selectedInside
        bool sameDayOnly = not same3cInsideClose and not na(selected3c) and not na(selectedInside) and str.format_time(selected3c,"yyyy-MM-dd","Etc/UTC") == str.format_time(selectedInside,"yyyy-MM-dd","Etc/UTC")
        string overlapLabel = same3cInsideClose ? "MISMO CIERRE" : sameDayOnly ? "MISMO DIA" : na(selected3c) or na(selectedInside) ? "N/D" : "CIERRE DIST"
        string selectedLabel = selectedReady ? "S"+str.tostring(selected+1)+" "+array.get(scanNames,selected) : "SIN SLOT / BROKER"
        table.cell(board,0,12,selectedLabel,bgcolor=shade,text_color=selectedReady ? color.aqua : color.orange,text_size=size.tiny)
        table.cell(board,1,12,"2C UTCmin",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,2,12,"3C UTCmin",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,3,12,"INS UTCmin",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,4,12,"M4 UTCmin",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,12,"MN UTCmin",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,0,13,"HIST NO PUSH",bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,1,13,f_qaHistoryMin(selectedReady ? array.get(qaHistRatified2CBySlot,selected) : na),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,13,f_qaHistoryMin(selected3c),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,13,f_qaHistoryMin(selectedInside),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,4,13,f_qaHistoryMin(selectedReady ? array.get(qaHistMulti4BySlot,selected) : na),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,5,13,f_qaHistoryMin(selectedReady ? array.get(qaHistMultiNBySlot,selected) : na),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,0,14,overlapLabel,bgcolor=shade,text_color=same3cInsideClose ? color.orange : color.gray,text_size=size.tiny)
        table.cell(board,1,14,"*3C=INS:"+str.tostring(exact3cInsideCloses),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        // Measured source responses, not a hardcoded "34 FEEDS".
        // When history is empty, these distinguish no source response
        // from a responding source that did not form an eligible C1.
        bool selectedFeedOK = selectedReady and array.get(auditFeedAvailable,selected) == 1
        int selectedC1Count = selectedFeedOK ? array.get(auditFeedC1,selected) : 0
        int selectedH4Closed = selectedFeedOK ? array.get(auditFeedH4Closed,selected) : 0
        int selectedH4LastBars = selectedFeedOK ? array.get(auditFeedH4LastBars,selected) : na
        table.cell(board,2,14,"R:"+str.tostring(checked)+"/"+str.tostring(nFeeds),bgcolor=shade,text_color=checked == nFeeds ? color.gray : color.orange,text_size=size.tiny)
        table.cell(board,3,14,not selectedReady ? "S:NO BROKER" : selectedFeedOK ? "S:FEED OK" : "S:SIN FEED",bgcolor=shade,text_color=selectedFeedOK ? color.gray : color.orange,text_size=size.tiny)
        table.cell(board,4,14,selectedFeedOK ? "C1:"+str.tostring(selectedC1Count) : "C1:N/D",bgcolor=shade,text_color=selectedC1Count == 0 ? color.orange : color.gray,text_size=size.tiny)
        table.cell(board,5,14,selectedFeedOK ? "H4:"+str.tostring(selectedH4Closed)+"/"+(na(selectedH4LastBars) ? "N/D" : str.tostring(selectedH4LastBars)) : "H4:N/D",bgcolor=shade,text_color=selectedH4Closed == 0 ? color.orange : color.gray,text_size=size.tiny)


f_qaAuditTime(int t) =>
    qaReadableUtc ? (na(t) or t <= 0 ? "N/D" : str.format_time(t,"dd/MM HH:mm","Etc/UTC")) : f_qaHistoryMin(t)

// Read-only per-source event audit. Same Signal data, no extra requests.
f_renderSlotEventAudit() =>
    if barstate.islast and showDashboard and not qaFamilyHistoryView and showSlotEventAudit
        table.clear(board,0,0,5,14)
        int slot = math.min(math.max(qaEventSlot - 1,0),33)
        if not scanAll
            slot := 7
        else if qaFollowChart
            slot := -1
            string exactTicker = ticker.standard(syminfo.tickerid)
            for i = 0 to 33
                if ticker.standard(array.get(scanSymbols,i)) == exactTicker
                    slot := i
                    break
        bool known = slot >= 0
        bool good = known and array.get(auditFeedAvailable,slot) == 1
        string name = known ? "S"+str.tostring(slot+1)+" "+array.get(scanNames,slot) : "SIN SLOT / BROKER"
        string[] headers = array.from("SLOT","FEED","C1","SWEEP","RAT","MSS15")
        string[] values = array.from(name,good ? "OK" : "N/D",
             f_qaAuditTime(known ? array.get(qaC1BySlot,slot) : na),
             f_qaAuditTime(known ? array.get(qaSweepBySlot,slot) : na),
             f_qaAuditTime(known ? array.get(qaRatBySlot,slot) : na),
             f_qaAuditTime(known ? array.get(qaBreak15BySlot,slot) : na))
        string[] h2 = array.from("MSS5","PIV5","PIV15","FASE","H4 BARRAS","C1 VALID")
        string[] v2 = array.from(
             f_qaAuditTime(known ? array.get(m5Times,slot) : na),
             f_qaAuditTime(known ? array.get(m5PivotTimes,slot) : na),
             f_qaAuditTime(known ? array.get(qaPivot15AtBySlot,slot) : na),
             good ? str.tostring(array.get(auditFeedPhaseMin,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedH4LastBars,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedC1,slot)) : "N/D")
        string[] h3 = array.from("EXTRA","C1 EX","SWEEP EX","RAT EX","M15 EX","QA")
        string[] v3 = array.from(known ? array.get(qaExtraKindBySlot,slot) : "N/D",
             f_qaAuditTime(known ? array.get(qaExtraC1BySlot,slot) : na),
             f_qaAuditTime(known ? array.get(qaExtraSweepBySlot,slot) : na),
             f_qaAuditTime(known ? array.get(qaExtraRatBySlot,slot) : na),
             f_qaAuditTime(known ? array.get(qaExtraBreak15BySlot,slot) : na),"NO PUSH")
        string[] h4 = array.from("H4 VALID","C1 CLOCK","C1 DATA","C1 RANGO","C2 RECH","H4 GAP")
        string[] v4 = array.from(
             good ? str.tostring(array.get(auditFeedH4Closed,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedC1Clock,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedC1Data,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedC1Range,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedC2Rejected,slot)) : "N/D",
             good ? str.tostring(array.get(auditFeedH4Gap,slot)) : "N/D")
        for col = 0 to 5
            table.cell(board,col,0,array.get(headers,col),bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,col,1,array.get(values,col),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,col,3,array.get(h2,col),bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,col,4,array.get(v2,col),bgcolor=shade,text_color=color.gray,text_size=size.tiny)
            table.cell(board,col,6,array.get(h3,col),bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,col,7,array.get(v3,col),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,col,9,array.get(h4,col),bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,col,10,array.get(v4,col),bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        if qaHistoricLast
            string[] hh = array.from("HIST 2C","HIST 3C","HIST INS","HIST M4","HIST MN","CERRADOS")
            int signed3 = known ? array.get(qaTrue3CSignedBySlot,slot) : na
            string[] vv = array.from(
                f_qaAuditTime(known ? array.get(qaHistRatified2CBySlot,slot) : na),
                f_qaAuditTime(na(signed3) ? na : int(math.abs(signed3))),
                f_qaAuditTime(known ? array.get(qaHistInsideReturnBySlot,slot) : na),
                f_qaAuditTime(known ? array.get(qaHistMulti4BySlot,slot) : na),
                f_qaAuditTime(known ? array.get(qaHistMultiNBySlot,slot) : na),"NO LIVE")
            for col = 0 to 5
                table.cell(board,col,12,array.get(hh,col),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
                table.cell(board,col,13,array.get(vv,col),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        else
            // QA 12M: diagnostico Multi4 del mismo slot, SOLO usando la
            // UDT del scan actual. No inventa pivotes ni agrega security().
            bool selectedMulti4 = good and array.get(qaExtraKindBySlot,slot) == "MULTI4 QA"
            int m4Sweep = selectedMulti4 ? array.get(qaExtraSweepBySlot,slot) : na
            int m4Pivot15At = selectedMulti4 ? array.get(qaExtraPivot15AtBySlot,slot) : na
            float m4Pivot15 = selectedMulti4 ? array.get(qaExtraPivot15PriceBySlot,slot) : na
            int m4Mss15 = selectedMulti4 ? array.get(qaExtraBreak15BySlot,slot) : na
            bool m4Mss5OK = selectedMulti4 and array.get(extraM5Flags,slot) == 1
            bool m4Mss15OK = selectedMulti4 and array.get(extraM15Flags,slot) == 1
            bool pivot15BeforeSweep = not na(m4Pivot15At) and not na(m4Sweep) and m4Pivot15At < m4Sweep and not na(m4Pivot15)
            string m4Status = not selectedMulti4 ? "NO MULTI4" : na(m4Sweep) ? "SIN SWEEP" : not pivot15BeforeSweep ? "SIN PIV15" : m4Mss15OK ? "M15 QA SI" : na(m4Mss15) ? "SIN MSS15" : "GATE M15"
            string[] m4Labels = array.from("M4 SWEEP","PIV15 PRE","PIV15 PR","MSS15 EX","MSS5 EX","M4 CAUSA")
            string[] m4Values = array.from(f_qaAuditTime(m4Sweep), f_qaAuditTime(m4Pivot15At),
                 na(m4Pivot15) ? "N/D" : str.tostring(m4Pivot15,format.mintick),
                 f_qaAuditTime(m4Mss15), m4Mss5OK ? "QA SI" : "NO VALID", m4Status)
            for col = 0 to 5
                table.cell(board,col,12,array.get(m4Labels,col),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
                table.cell(board,col,13,array.get(m4Values,col),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,0,14,"QA NO LIVE",bgcolor=navy,text_color=color.orange,text_size=size.tiny)

// Explicit 33 non-BTC evidence, paginated; never silently blanks the board.
f_renderNonBtcAudit() =>
    if barstate.islast and showDashboard and not qaFamilyHistoryView and not showSlotEventAudit and showNonBtcCohortQA
        table.clear(board,0,0,5,14)
        string[] header = qa33RootView ? array.from("MERCADO","FASE","INI ERR","FIN ERR","48 ERR","GAPS") : array.from("MERCADO","FEED","C1","H4","2C","M15 QA")
        for col = 0 to 5
            table.cell(board,col,0,array.get(header,col),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        int currentPage = math.min(math.max(page,1),4)
        int ordinal = 0
        for i = 0 to 33
            if i != 7
                int row = ordinal - (currentPage-1)*10 + 1
                if row >= 1 and row <= 10
                    bool available = scanAll and array.get(auditFeedAvailable,i) == 1
                    color bg = row % 2 == 0 ? shade : navy
                    string cell1 = not available ? "N/D" : qa33RootView ? str.tostring(array.get(auditFeedPhaseMin,i)) : "OK"
                    string cell2 = not available ? "N/D" : qa33RootView ? str.tostring(array.get(auditFeedH4StartMis,i)) : str.tostring(array.get(auditFeedC1,i))
                    string cell3 = not available ? "N/D" : qa33RootView ? str.tostring(array.get(auditFeedH4EndMis,i)) : str.tostring(array.get(auditFeedH4Closed,i))
                    string cell4 = not available ? "N/D" : qa33RootView ? str.tostring(array.get(auditFeedH4BarsMis,i)) : str.tostring(array.get(auditFeed2C,i))
                    string cell5 = not available ? "N/D" : qa33RootView ? str.tostring(array.get(auditFeedH4Gap,i)) : str.tostring(array.get(auditFeedM15QA,i))
                    string[] cells = array.from(array.get(scanNames,i),cell1,cell2,cell3,cell4,cell5)
                    for col = 0 to 5
                        table.cell(board,col,row,array.get(cells,col),bgcolor=bg,text_color=available ? color.white : color.orange,text_size=size.tiny)
                ordinal += 1
        string[] footer = array.from("QA 33 SIN BTC","P "+str.tostring(currentPage)+"/4",scanAll ? "33 FUENTES" : "BTC SOLO","R:"+str.tostring(checked)+"/"+str.tostring(scanAll ? 34 : 1),"NO LIVE","NO PUSH")
        for col = 0 to 5
            table.cell(board,col,12,array.get(footer,col),bgcolor=navy,text_color=color.orange,text_size=size.tiny)

// Ranking 0=both MSS, 1=M15 only, 2=M5 only, 3=2C no MSS,
// 4=other structural QA, 5=inactive/rejected (expanded only).
f_renderRadarDashboard() =>
    if barstate.islast and showDashboard and not qaFamilyHistoryView and not showSlotEventAudit and not showNonBtcCohortQA
        table.clear(board,0,0,5,14)
        table.cell(board,0,0,"MERCADO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,0,"CRT H4",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,0,"DIR",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,0,"MSS M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,0,"MSS M15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,0,"ETAPA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        var array<int> rankBySlot = array.new_int(34,5)
        var array<bool> ownM5BySlot = array.new_bool(34,false)
        var array<bool> ownM15BySlot = array.new_bool(34,false)
        int nFeeds = scanAll ? 34 : 1
        int coreCount = 0
        int qaStructCount = 0
        int coreM15Count = 0
        int qaM5Count = 0
        int qaM15Count = 0
        int activeCount = 0
        for i = 0 to 33
            bool requested = scanAll or i == 7
            bool core = requested and array.get(validCoreFlags,i)
            bool qaCore = requested and array.get(qaCoreObservedFlags,i)
            bool extra = requested and array.get(validCrtFlags,i) and not core and not qaCore
            int mask = requested ? array.get(qaCatalogPerFeed,i) : 0
            bool true3c = requested and not core and not qaCore and int(math.floor(mask / 1)) % 2 == 1 and not na(array.get(qaTrue3CSignedBySlot,i))
            bool insideObserved = requested and not core and not qaCore and int(math.floor(mask / 8)) % 2 == 1
            bool multiObserved = requested and not core and not qaCore and int(math.floor(mask / 32)) % 2 == 1
            bool otherStructural = (true3c or extra or insideObserved or multiObserved) and not core and not qaCore
            [m5,m15] = f_monitorOwnMss(i)
            // TRUE 3C has priority in visible QA role. Its MSS5/15
            // are N/V until owned by its distinct C1/sweep. Never
            // borrow Inside/Multi-N MSS under a 3C TRUE label.
            bool extraDisplayed = extra and (not true3c or array.get(qaExtraKindBySlot,i) == "3C TRUE QA")
            bool extraM15 = extraDisplayed and array.get(extraM15Flags,i) == 1
            bool extraM5 = extraDisplayed and array.get(extraM5Flags,i) == 1
            int rank = not requested ? 5 : (core or qaCore) ? (m5 and m15 ? 0 : m15 ? 1 : m5 ? 2 : 3) : extraM5 and extraM15 ? 0 : extraM15 ? 1 : extraM5 ? 2 : otherStructural ? 4 : 5
            array.set(rankBySlot,i,rank)
            array.set(ownM5BySlot,i,m5)
            array.set(ownM15BySlot,i,m15)
            if requested
                if core
                    coreCount += 1
                    if m15
                        coreM15Count += 1
                else if qaCore or otherStructural
                    qaStructCount += 1
                if qaCore and m5 or extraM5
                    qaM5Count += 1
                if qaCore and m15 or extraM15
                    qaM15Count += 1
                if rank < 5
                    activeCount += 1
        int onPage = expandFull34 ? 10 : compactPriorityRows
        int visibleCount = expandFull34 ? nFeeds : activeCount
        int totalPages = math.max(1,int(math.ceil(visibleCount * 1.0 / onPage)))
        int pageNow = math.min(math.max(page,1),totalPages)
        int visited = 0
        int drawn = 0
        // Prefer the current graph only for the exact scanned broker+symbol.
        int chartSlot = -1
        string chartBroker = ticker.standard(syminfo.tickerid)
        for slot = 0 to 33
            if (scanAll or slot == 7) and ticker.standard(array.get(scanSymbols,slot)) == chartBroker
                chartSlot := slot
                break
        for priority = -1 to 5
            for i = 0 to 33
                bool requested = scanAll or i == 7
                int rank = array.get(rankBySlot,i)
                bool chartFirst = priority == -1 and i == chartSlot
                bool rankedOther = priority >= 0 and priority == rank and i != chartSlot
                bool visibleRow = requested and (chartFirst or rankedOther) and (expandFull34 or rank < 5)
                if visibleRow
                    if visited >= (pageNow-1)*onPage and drawn < onPage
                        int rowIndex = drawn + 1
                        bool core = array.get(validCoreFlags,i)
                        bool qaCore = array.get(qaCoreObservedFlags,i)
                        bool extra = array.get(validCrtFlags,i) and not core and not qaCore
                        int mask = array.get(qaCatalogPerFeed,i)
                        bool catTrue3 = int(math.floor(mask / 1)) % 2 == 1
                        bool cat2 = int(math.floor(mask / 2)) % 2 == 1
                        bool catExpansion = int(math.floor(mask / 4)) % 2 == 1
                        bool catInsideReturn = int(math.floor(mask / 8)) % 2 == 1
                        bool catInsideCont = int(math.floor(mask / 16)) % 2 == 1
                        bool catMulti = int(math.floor(mask / 32)) % 2 == 1
                        bool catRetest = int(math.floor(mask / 64)) % 2 == 1
                        int signed3 = array.get(qaTrue3CSignedBySlot,i)
                        bool true3c = catTrue3 and not core and not qaCore and not na(signed3)
                        bool otherQA = rank == 4 or extra
                        int dir = true3c ? (signed3 > 0 ? 1 : -1) : core or extra ? array.get(directions,i) : qaCore ? array.get(qaObservedDirectionBySlot,i) : 0
                        bool feedOK = array.get(auditFeedAvailable,i) == 1
                        bool ownM5 = array.get(ownM5BySlot,i)
                        bool ownM15 = array.get(ownM15BySlot,i)
                        // Match dashboard priority: do not show an
                        // auxiliary-family MSS beside TRUE 3C.
                        bool ownExtraM15 = extra and (not true3c or array.get(qaExtraKindBySlot,i) == "3C TRUE QA") and array.get(extraM15Flags,i) == 1
                        bool ownExtraM5 = extra and (not true3c or array.get(qaExtraKindBySlot,i) == "3C TRUE QA") and array.get(extraM5Flags,i) == 1
                        bool coreC1Ready = array.get(qaCoreC1ReadyBySlot,i)
                        bool otherC1Ready = array.get(qaOtherC1ReadyBySlot,i)
                        string otherC1Kind = array.get(qaOtherC1KindBySlot,i)
                        string extraKind = array.get(familyLabels,i)
                        bool c1Ready = (core or qaCore) ? coreC1Ready : true3c ? otherC1Ready and otherC1Kind == "3C TRUE QA" : extra ? otherC1Ready and otherC1Kind == extraKind : false
                        bool qaDiagnostics = expandFull34 and showCatalog7
                        string role = not feedOK ? "SIN FEED" : core ? "2C RAT" : qaCore ? "2C QA" : true3c ? "3C TRUE QA" : extra ? extraKind : catInsideReturn ? "INS RET QA" : catMulti ? "MULTI QA" : qaDiagnostics ? catExpansion ? "EXP RECH" : catInsideCont ? "INS RECH" : cat2 ? "2C*" : catRetest ? "RETEST QA" : "—" : "—"
                        string stage = not feedOK ? "SIN FEED" : core ? "C3 ACT" : qaCore ? "C3 QA" : true3c ? "C3 CERR QA" : otherQA ? "QA H4" : qaDiagnostics ? catExpansion or catInsideCont ? "RECHAZO" : cat2 ? "PENDIENTE" : catRetest ? "QA MSS" : "ESPERA" : "ESPERA"
                        bool lacksC1 = (core or qaCore or otherQA or true3c) and not c1Ready
                        string visibleStage = lacksC1 ? "C1 N/D" : stage
                        string m5Text = core ? (ownM5 ? "SI" : "NO") : qaCore ? (ownM5 ? "QA SI" : "QA --") : ownExtraM5 ? "QA SI" : otherQA ? "N/V" : "—"
                        string m15Text = core ? (ownM15 ? "SI" : "NO") : qaCore ? (ownM15 ? "QA SI" : "QA --") : ownExtraM15 ? "QA SI" : otherQA ? "N/V" : "—"
                        string dirText = core or qaCore or otherQA or true3c ? (dir > 0 ? "ALC" : dir < 0 ? "BAJ" : "N/V") : "—"
                        color bg = rowIndex % 2 == 0 ? shade : navy
                        color stateInk = core ? posInk : core or qaCore or otherQA or true3c ? color.orange : color.gray
                        table.cell(board,0,rowIndex,(i == chartSlot ? "▶ " : "") + array.get(scanNames,i),bgcolor=bg,text_color=feedOK ? color.white : color.orange,text_size=size.tiny)
                        table.cell(board,1,rowIndex,role,bgcolor=bg,text_color=stateInk,text_size=size.tiny)
                        table.cell(board,2,rowIndex,dirText,bgcolor=bg,text_color=dir > 0 ? posInk : dir < 0 ? negInk : color.gray,text_size=size.tiny)
                        table.cell(board,3,rowIndex,m5Text,bgcolor=bg,text_color=core and ownM5 ? posInk : qaCore and ownM5 or ownExtraM5 ? color.orange : color.gray,text_size=size.tiny)
                        table.cell(board,4,rowIndex,m15Text,bgcolor=bg,text_color=core and ownM15 ? posInk : qaCore and ownM15 or ownExtraM15 ? color.orange : color.gray,text_size=size.tiny)
                        table.cell(board,5,rowIndex,visibleStage,bgcolor=bg,text_color=lacksC1 ? color.orange : stateInk,text_size=size.tiny)
                        drawn += 1
                    visited += 1
        if not expandFull34 and activeCount == 0
            table.cell(board,0,1,"SIN CRT VIGENTE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
            table.cell(board,1,1,str.tostring(nFeeds)+" VIGILADOS",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        int footer = onPage + 1
        table.cell(board,0,footer,expandFull34 ? "P "+str.tostring(pageNow)+"/"+str.tostring(totalPages) : "CRT:"+str.tostring(coreCount),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,1,footer,"C:"+str.tostring(coreCount),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,footer,"QA:"+str.tostring(qaStructCount),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,footer,"M5q:"+str.tostring(qaM5Count),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,4,footer,"M15q:"+str.tostring(qaM15Count),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,5,footer,"R:"+str.tostring(checked)+"/"+str.tostring(nFeeds),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        int infoRow = onPage + 2
        table.cell(board,0,infoRow,"M15c:"+str.tostring(coreM15Count),bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,1,infoRow,"QA NO CERT",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,2,infoRow,showCatalog7 ? "7 ROLES QA" : "4 BASE + VAR",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,infoRow,"H4 24H",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,4,infoRow,"NO LIVE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,infoRow,"NO PUSH",bgcolor=shade,text_color=color.gray,text_size=size.tiny)

f_renderRadarDashboard()

f_renderFamilyHistory()

f_renderSlotEventAudit()

f_renderNonBtcAudit()


// V34.12Q: detector FVG nativo del H4 del ticker ABIERTO.
 // Se solicita con lookahead_on pero solo lee H4 [1..N] CERRADAS:
 // sin futuro, sin mezclar NY/M5 del escaner y sin depender de CRT.
 // Formacion: tres H4 completas y consecutivas; vela #3 deja gap
 // entre LOW 3 y HIGH 1 (alcista) o HIGH 3 y LOW 1 (bajista).
 // Mitigacion: mecha posterior toca una zona; relleno total la retira.
f_chartH4Fvgs(int depth) =>
    // H4 solo CONFIRMADAS: k>=1. Se ranking por proximidad a
    // ultima close H4 confirmada; no por juventud de la zona.
    array<float> tops = array.new_float()
    array<float> bottoms = array.new_float()
    array<int> dirs = array.new_int()
    array<int> times = array.new_int()
    array<bool> partials = array.new_bool()
    array<bool> used = array.new_bool()
    float confirmedH4Atr = ta.atr(14)[1]
    float referencePrice = close[1]
    for k = 1 to depth
        bool consecutive = not na(time[k + 2]) and not na(time[k + 1]) and not na(time[k]) and time[k + 1] - time[k + 2] == H4MS and time[k] - time[k + 1] == H4MS
        bool gapBull = consecutive and not na(low[k]) and not na(high[k + 2]) and low[k] - high[k + 2] >= syminfo.mintick
        bool gapBear = consecutive and not na(high[k]) and not na(low[k + 2]) and low[k + 2] - high[k] >= syminfo.mintick
        if gapBull or gapBear
            float top = gapBull ? low[k] : low[k + 2]
            float bottom = gapBull ? high[k + 2] : high[k]
            bool fullyFilled = false
            bool partlyFilled = false
            if k > 1
                for j = 1 to k - 1
                    if gapBull
                        if low[j] <= bottom
                            fullyFilled := true
                        else if low[j] <= top
                            partlyFilled := true
                    else
                        if high[j] >= top
                            fullyFilled := true
                        else if high[j] >= bottom
                            partlyFilled := true
            if not fullyFilled and top > bottom and not na(time_close[k])
                array.push(tops,top)
                array.push(bottoms,bottom)
                array.push(dirs,gapBull ? 1 : -1)
                array.push(times,time_close[k])
                array.push(partials,partlyFilled)
                array.push(used,false)
    float t1 = na
    float b1 = na
    int d1 = 0
    int a1 = na
    bool p1 = false
    float t2 = na
    float b2 = na
    int d2 = 0
    int a2 = na
    bool p2 = false
    float t3 = na
    float b3 = na
    int d3 = 0
    int a3 = na
    bool p3 = false
    // Elegir TRES zonas mas proximas; en empate prioriza la
    // mas reciente porque el vector se creo k=1..depth.
    if array.size(tops) > 0 and not na(referencePrice)
        for rank = 0 to 2
            int best = na
            float bestDistance = na
            for idx = 0 to array.size(tops) - 1
                if not array.get(used,idx)
                    float top = array.get(tops,idx)
                    float bottom = array.get(bottoms,idx)
                    float dist = referencePrice > top ? referencePrice - top : referencePrice < bottom ? bottom - referencePrice : 0.0
                    if na(bestDistance) or dist < bestDistance
                        bestDistance := dist
                        best := idx
            if not na(best)
                array.set(used,best,true)
                if rank == 0
                    t1 := array.get(tops,best)
                    b1 := array.get(bottoms,best)
                    d1 := array.get(dirs,best)
                    a1 := array.get(times,best)
                    p1 := array.get(partials,best)
                else if rank == 1
                    t2 := array.get(tops,best)
                    b2 := array.get(bottoms,best)
                    d2 := array.get(dirs,best)
                    a2 := array.get(times,best)
                    p2 := array.get(partials,best)
                else
                    t3 := array.get(tops,best)
                    b3 := array.get(bottoms,best)
                    d3 := array.get(dirs,best)
                    a3 := array.get(times,best)
                    p3 := array.get(partials,best)
    [t1,b1,d1,a1,p1,t2,b2,d2,a2,p2,t3,b3,d3,a3,p3,confirmedH4Atr]

// El mismo simbolo abierto (IC:US30 no es OANDA:US30).
// +1 solicitud unica 240m: 34 M5 + 1 Daily + 1 H4 = 36.
[fvg1Top,fvg1Bottom,fvg1Dir,fvg1At,fvg1PartialHist,fvg2Top,fvg2Bottom,fvg2Dir,fvg2At,fvg2PartialHist,fvg3Top,fvg3Bottom,fvg3Dir,fvg3At,fvg3PartialHist,fvgConfirmedAtr] = request.security(syminfo.tickerid, "240", f_chartH4Fvgs(chartFvgLookbackH4), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=110)

// En la H4 actual, monitorizar solo la mecha OBSERVADA, sin leer
// del futuro la high/low de una H4 que todavia no ha cerrado.
int openNativeH4 = time("240")
var int chartH4OpenSeen = na
var float currentH4HighSeen = na
var float currentH4LowSeen = na
if not na(openNativeH4)
    if na(chartH4OpenSeen) or openNativeH4 != chartH4OpenSeen
        chartH4OpenSeen := openNativeH4
        currentH4HighSeen := high
        currentH4LowSeen := low
    else
        currentH4HighSeen := math.max(currentH4HighSeen, high)
        currentH4LowSeen := math.min(currentH4LowSeen, low)


// La funcion gestiona SOLO objetos visuales del grafico; NO actualiza
// el detector CRT ni los calculos MSS, ni crea alertas.
f_drawChartFvg(box existingBox, label existingLabel, bool enabled, float zoneTop, float zoneBottom, int bornAt, int dir, bool partial, int endAt) =>
    box b = existingBox
    label l = existingLabel
    if enabled and not na(bornAt) and endAt > bornAt
        color ink = dir == 1 ? color.teal : color.rgb(192, 82, 64)
        color fillInk = color.new(ink, partial ? 88 : 83)
        string titleText = "FVG H4 " + (dir == 1 ? "ALC " : "BAJ ") + (partial ? "PARCIAL" : "INTACTO")
        if na(b)
            b := box.new(left=bornAt,top=zoneTop,right=endAt,bottom=zoneBottom,xloc=xloc.bar_time,border_color=color.new(ink,35),bgcolor=fillInk)
        if na(l)
            l := label.new(endAt,zoneTop,titleText,xloc=xloc.bar_time,style=label.style_label_left,textcolor=ink,color=color.new(ink,100),size=size.tiny)
        box.set_lefttop(b,bornAt,zoneTop)
        box.set_rightbottom(b,endAt,zoneBottom)
        box.set_bgcolor(b,fillInk)
        box.set_border_color(b,color.new(ink,35))
        label.set_xy(l,endAt,zoneTop)
        label.set_text(l,titleText)
        label.set_textcolor(l,ink)
    else
        if not na(b)
            box.delete(b)
            b := na
        if not na(l)
            label.delete(l)
            l := na
    [b,l]

// V34.12K: Chart B VISUAL SOLO del feed ya solicitado por Radar A.
// No solicitar un feed #35; la misma UDT y el mismo f_engine() se reutilizan.
// Los niveles de un broker diferente nunca se dibujan contra este grafico.
Signal own = integratedOwn
bool chartBtcSymbol = str.upper(syminfo.ticker) == "BTCUSD"
bool chartAvailable = chartIsIC and integratedSlot >= 0 and not na(own) and not na(own.phase)
// H4 chart puede iniciar en hora distinta al bloque H4 reconstruido por
// el feed M5 exacto (+1/+2 min o calendario del proveedor). Requerir
// exigir igualdad exacta con time suprimia dibujos validos EN H4. El dibujo usa
// xloc.bar_time, C1/C2 y OHLC del mismo slot, no H4 del chart mezclada.
bool visualChartAligned = timeframe.isintraday and (timeframe.multiplier == 5 or timeframe.multiplier == 15 or timeframe.multiplier == 240)
// Nunca dibujar una C2 provisional o un bit de mascara sin C1 y OHLC verificados.
// Retener un 2C verificado hasta su ventana de MEMORIA sin presentarlo
// como CRT EN CURSO. El modelo marca phase=3 para este estado.
bool chartCoreActive = chartAvailable and own.phase == 2 and own.isPatternValid and own.modelKind == "CRT_2C_RETURN" and not na(own.c1Start) and not na(own.crtC2Start) and not na(own.crtRatifiedAt) and own.crtRatifiedAt >= own.crtC2Start + H4MS and not na(own.crh) and not na(own.crl) and own.crh > own.crl
bool chartCoreHistorical = chartAvailable and own.phase == 3 and own.isPatternValid and own.modelKind == "CRT_2C_RETURN" and not na(own.c1Start) and not na(own.crtC2Start) and not na(own.crh) and not na(own.crl) and own.crh > own.crl
bool chartCoreC1 = chartCoreActive or chartCoreHistorical
bool chartExtraC1 = chartAvailable and not chartCoreC1 and not na(own.familyVisual) and own.familyVisual.structuralQA and not na(own.familyVisual.c1Start) and not na(own.familyVisual.eventClosedAt) and not na(own.familyVisual.c1High) and not na(own.familyVisual.c1Low) and own.familyVisual.c1High > own.familyVisual.c1Low
int displayC1 = chartCoreC1 ? own.c1Start : chartExtraC1 ? own.familyVisual.c1Start : na
float displayCRH = chartCoreC1 ? own.crh : chartExtraC1 ? own.familyVisual.c1High : na
float displayCRL = chartCoreC1 ? own.crl : chartExtraC1 ? own.familyVisual.c1Low : na
string displayFamily = chartCoreHistorical ? "2C HIST QA" : chartCoreActive ? ((not qaPhase1NonBtc or chartBtcSymbol) ? "2C RAT" : "2C QA") : chartExtraC1 ? own.familyVisual.kind : "NONE"
int displayEnd = chartCoreC1 ? own.c1Start + 3 * H4MS : chartExtraC1 ? own.familyVisual.eventClosedAt + H4MS : na
bool visible = visualChartAligned and (chartCoreC1 or chartExtraC1) and not na(displayC1) and not na(displayCRH) and not na(displayCRL) and not na(displayEnd) and displayCRH > displayCRL and displayEnd > displayC1 and time_close >= displayC1

// Variables chartAvailable y visible estan declaradas ANTES de los
// estados FVG: Pine no admite referencias hacia una declaracion posterior.
bool fvgChartOK = chartIsIC and showChartH4Fvg and timeframe.isintraday and timeframe.in_seconds(timeframe.period) <= H4MS / 1000 and not na(openNativeH4)
// ATR confirmado, nunca la ATR de la barra H4 aun abierta.
f_chartZoneDistance(float px, float top, float bottom) =>
    px > top ? px - top : px < bottom ? bottom - px : 0.0
// V34.12U: las 3 zonas historicamente cercanas son CANDIDATAS,
 // nunca asignar maxZones o distancia antes de comprobar relleno.
 // Se considera la distancia al precio del chart ACTUAL y luego
 // se elige la primera, segunda, tercera RELEVANTE sin huecos.
 // Evita el bug: zona #1 antigua lejos => ocultar zona #2 cercana.
bool fvgAtrReady = not na(fvgConfirmedAtr) and fvgConfirmedAtr > 0
bool fvg1Base = fvgChartOK and not na(fvg1At) and not na(fvg1Top) and not na(fvg1Bottom) and fvg1Top > fvg1Bottom and fvg1Dir != 0 and fvg1At < time_close
bool fvg2Base = fvgChartOK and not na(fvg2At) and not na(fvg2Top) and not na(fvg2Bottom) and fvg2Top > fvg2Bottom and fvg2Dir != 0 and fvg2At < time_close
bool fvg3Base = fvgChartOK and not na(fvg3At) and not na(fvg3Top) and not na(fvg3Bottom) and fvg3Top > fvg3Bottom and fvg3Dir != 0 and fvg3At < time_close
bool fvg1FilledNow = fvg1Base and (fvg1Dir == 1 ? currentH4LowSeen <= fvg1Bottom : currentH4HighSeen >= fvg1Top)
bool fvg2FilledNow = fvg2Base and (fvg2Dir == 1 ? currentH4LowSeen <= fvg2Bottom : currentH4HighSeen >= fvg2Top)
bool fvg3FilledNow = fvg3Base and (fvg3Dir == 1 ? currentH4LowSeen <= fvg3Bottom : currentH4HighSeen >= fvg3Top)
bool fvg1PartialNow = fvg1PartialHist or (fvg1Base and (fvg1Dir == 1 ? currentH4LowSeen <= fvg1Top : currentH4HighSeen >= fvg1Bottom))
bool fvg2PartialNow = fvg2PartialHist or (fvg2Base and (fvg2Dir == 1 ? currentH4LowSeen <= fvg2Top : currentH4HighSeen >= fvg2Bottom))
bool fvg3PartialNow = fvg3PartialHist or (fvg3Base and (fvg3Dir == 1 ? currentH4LowSeen <= fvg3Top : currentH4HighSeen >= fvg3Bottom))
float disabledDistance = 1e20
float fvg1ChartDistance = fvg1Base and not fvg1FilledNow and fvgAtrReady ? f_chartZoneDistance(close,fvg1Top,fvg1Bottom) : disabledDistance
float fvg2ChartDistance = fvg2Base and not fvg2FilledNow and fvgAtrReady ? f_chartZoneDistance(close,fvg2Top,fvg2Bottom) : disabledDistance
float fvg3ChartDistance = fvg3Base and not fvg3FilledNow and fvgAtrReady ? f_chartZoneDistance(close,fvg3Top,fvg3Bottom) : disabledDistance
float fvgMaxChartDistance = fvgAtrReady ? fvgConfirmedAtr * chartFvgMaxAtr : 0.0
array<float> fvgDistances = array.from(
     fvg1ChartDistance <= fvgMaxChartDistance ? fvg1ChartDistance : disabledDistance,
     fvg2ChartDistance <= fvgMaxChartDistance ? fvg2ChartDistance : disabledDistance,
     fvg3ChartDistance <= fvgMaxChartDistance ? fvg3ChartDistance : disabledDistance)
array<int> fvgRanked = array.sort_indices(fvgDistances,order.ascending)
int fvgSelectedIndex1 = array.get(fvgRanked,0)
int fvgSelectedIndex2 = array.get(fvgRanked,1)
int fvgSelectedIndex3 = array.get(fvgRanked,2)
array<float> fvgTopsChart = array.from(fvg1Top,fvg2Top,fvg3Top)
array<float> fvgBottomsChart = array.from(fvg1Bottom,fvg2Bottom,fvg3Bottom)
array<int> fvgDirsChart = array.from(fvg1Dir,fvg2Dir,fvg3Dir)
array<int> fvgTimesChart = array.from(fvg1At,fvg2At,fvg3At)
array<bool> fvgPartialsChart = array.from(fvg1PartialNow,fvg2PartialNow,fvg3PartialNow)
bool drawFvg1 = chartFvgMaxZones >= 1 and array.get(fvgDistances,fvgSelectedIndex1) < disabledDistance
bool drawFvg2 = chartFvgMaxZones >= 2 and array.get(fvgDistances,fvgSelectedIndex2) < disabledDistance
bool drawFvg3 = chartFvgMaxZones >= 3 and array.get(fvgDistances,fvgSelectedIndex3) < disabledDistance
float drawFvg1Top = array.get(fvgTopsChart,fvgSelectedIndex1)
float drawFvg1Bottom = array.get(fvgBottomsChart,fvgSelectedIndex1)
int drawFvg1Dir = array.get(fvgDirsChart,fvgSelectedIndex1)
int drawFvg1At = array.get(fvgTimesChart,fvgSelectedIndex1)
bool drawFvg1Partial = array.get(fvgPartialsChart,fvgSelectedIndex1)
float drawFvg2Top = array.get(fvgTopsChart,fvgSelectedIndex2)
float drawFvg2Bottom = array.get(fvgBottomsChart,fvgSelectedIndex2)
int drawFvg2Dir = array.get(fvgDirsChart,fvgSelectedIndex2)
int drawFvg2At = array.get(fvgTimesChart,fvgSelectedIndex2)
bool drawFvg2Partial = array.get(fvgPartialsChart,fvgSelectedIndex2)
float drawFvg3Top = array.get(fvgTopsChart,fvgSelectedIndex3)
float drawFvg3Bottom = array.get(fvgBottomsChart,fvgSelectedIndex3)
int drawFvg3Dir = array.get(fvgDirsChart,fvgSelectedIndex3)
int drawFvg3At = array.get(fvgTimesChart,fvgSelectedIndex3)
bool drawFvg3Partial = array.get(fvgPartialsChart,fvgSelectedIndex3)
plot(fvgChartOK ? (drawFvg1 ? 1 : 0) + (drawFvg2 ? 1 : 0) + (drawFvg3 ? 1 : 0) : na, title="QA FVG H4 zonas validas cercanas (0-3)",display=display.data_window)
plot(drawFvg1 ? drawFvg1Top : na,title="QA FVG H4 mas cercano techo",display=display.data_window)
plot(drawFvg1 ? drawFvg1Bottom : na,title="QA FVG H4 mas cercano suelo",display=display.data_window)

// Ventana de datos: por que no hay lineas (mismatch broker, sin C1 o TF no admitido).
plot(integratedSlot >= 0 ? integratedSlot + 1 : na, title="QA Chart integrado slot 1-34", display=display.data_window)
plot(showIntegratedChart and visible ? displayCRH : na, title="QA Chart integrado CRH", display=display.data_window)
plot(showIntegratedChart and visible ? displayCRL : na, title="QA Chart integrado CRL", display=display.data_window)
// V34.12P conserva la correccion DAILY previa: la referencia visual debe ser la vela DAILY
// confirmada ANTERIOR de este MISMO ticker. La sesion RTH de US30
// (09:30-16 NY) NO equivale necesariamente al 1D del proveedor.
// La expresion [1] con lookahead_on es no-repainting. Una sola
// solicitud DIARIA extra SOLO del grafico, no un simbolo #35.
// Con 34 fuentes M5 + 1 diaria seguimos bajo el limite Basic 40.
// 12S: los niveles SOLO pertenecen al ticker ABIERTO (syminfo.tickerid).
// NUNCA dependen de: CRT Signal, chartStaticSlot, NY RTH ni barras H4
// con el mismo horario que la vela Daily del proveedor.
// Precios confirmados D[1] con lookahead_on; time de D actual es
// conocido en su apertura, no OHLC futuro.
[dailyPDH, dailyPDL, dailyPrevOpen, dailyNowOpen] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1], time], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=60)
// Solo para observar HIGH/LOW que van formandose HOY en tiempo real:
// lookahead_off, verificacion de fecha y SOLO usar sobre barstate.islast.
// En barras historicas no se atribuye la HIGH final al comienzo del dia.
[dailyLiveHigh, dailyLiveLow, dailyLiveOpen] = request.security(syminfo.tickerid, "D", [high, low, time], lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=60)
bool dailyDataOK = chartIsIC and not na(dailyPDH) and not na(dailyPDL) and not na(dailyPrevOpen) and not na(dailyNowOpen) and dailyPDH > dailyPDL and dailyPrevOpen < dailyNowOpen
bool chartTfSupportsDaily = (timeframe.isintraday and timeframe.in_seconds(timeframe.period) <= 14400) or (timeframe.isdaily and timeframe.multiplier == 1)
bool showPDLevels = showChartPDHPDL and chartTfSupportsDaily and dailyDataOK
plot(showPDLevels ? dailyPDH : na, title="QA Chart PDH 1D previo confirmado", display=display.data_window)
plot(showPDLevels ? dailyPDL : na, title="QA Chart PDL 1D previo confirmado", display=display.data_window)
plot(showPDLevels ? dailyNowOpen / 60000.0 : na, title="QA Chart inicio Daily del proveedor UTCmin", display=display.data_window)
plot(dailyDataOK ? 1 : 0, title="QA datos Daily confiables (1=SI, 0=NO)", display=display.data_window)
// V34.12Q: ESTADO TOMADO/INTACTO del PDH y PDL DAILY del mismo chart.
// Un nivel se considera TOMADO por mecha HIGH>=PDH o LOW<=PDL.
// SOLO precios observados desde el inicio del dia 1D de este proveedor.
// No confundir el estado 1D con own.pdhStatus/pdlStatus RTH del motor M5.
var int chartDailySeenAt = na
var bool chartPdhTaken1D = false
var bool chartPdlTaken1D = false
var int chartPdhFirstBarAt = na
var int chartPdlFirstBarAt = na
if not na(dailyNowOpen) and (na(chartDailySeenAt) or chartDailySeenAt != dailyNowOpen)
    chartDailySeenAt := dailyNowOpen
    chartPdhTaken1D := false
    chartPdlTaken1D := false
    chartPdhFirstBarAt := na
    chartPdlFirstBarAt := na
// Una barra H4 que cruza el limite diario no equivale a una
// vela Daily: no atribuirle sus mechas completas al nuevo dia.
// En M5/M15/Daily se usa el high/low solo si empezo EN el dia.
bool currentChartBarBelongsToDaily = not na(dailyNowOpen) and time >= dailyNowOpen
if dailyDataOK and currentChartBarBelongsToDaily
    if not chartPdhTaken1D and high >= dailyPDH
        chartPdhTaken1D := true
        chartPdhFirstBarAt := time
    if not chartPdlTaken1D and low <= dailyPDL
        chartPdlTaken1D := true
        chartPdlFirstBarAt := time
// Reconciliacion observacional de la vela Daily en progreso.
// Abarca toda la sesion aunque el usuario abra 4H y la primera
// H4 cruce la apertura diaria, o cuando faltan velas intradia.
bool dailyLiveSameDay = barstate.islast and dailyDataOK and not na(dailyLiveOpen) and dailyLiveOpen == dailyNowOpen
if dailyLiveSameDay
    if not chartPdhTaken1D and not na(dailyLiveHigh) and dailyLiveHigh >= dailyPDH
        chartPdhTaken1D := true
        chartPdhFirstBarAt := time
    if not chartPdlTaken1D and not na(dailyLiveLow) and dailyLiveLow <= dailyPDL
        chartPdlTaken1D := true
        chartPdlFirstBarAt := time
plot(showPDLevels ? (chartPdhTaken1D ? 1 : 0) : na, title="QA PDH 1D estado (1=tomado, 0=intacto)", display=display.data_window)
plot(showPDLevels ? (chartPdlTaken1D ? 1 : 0) : na, title="QA PDL 1D estado (1=tomado, 0=intacto)", display=display.data_window)
plot(showPDLevels and chartPdhTaken1D ? chartPdhFirstBarAt / 60000.0 : na, title="QA PDH 1D primera vela toma UTCmin", display=display.data_window)
plot(showPDLevels and chartPdlTaken1D ? chartPdlFirstBarAt / 60000.0 : na, title="QA PDL 1D primera vela toma UTCmin", display=display.data_window)

// El panel no depende de la escala vertical de precios: si PDH/PDL
// estan fuera de pantalla o el objeto line se oculta por zoom, el
// valor y su estado siguen siendo visibles.
// QA: si la fuente Daily falta, mostrar FALTA D (no inventar precio).
var table chartDailyPanel = table.new(position.bottom_right,1,3,frame_width=0,border_width=0)
if barstate.islast
    color panelBackground = color.new(color.black,78)
    table.cell(chartDailyPanel,0,0,chartIsIC ? "IC · " + syminfo.ticker : "FUENTE NO IC · CAMBIA GRAFICO",text_color=chartIsIC ? color.white : color.orange,bgcolor=panelBackground,text_size=size.tiny)
    string topText = not chartIsIC ? "PDH BLOQUEADO · NO IC" : not showChartPDHPDL ? "PDH DESACTIVADO" : not chartTfSupportsDaily ? "PDH TF NO SOPORTADA" : not dailyDataOK ? "PDH SIN D (verificar datos)" : "PDH " + str.tostring(dailyPDH,format.mintick) + " · " + (chartPdhTaken1D ? "TOMADO" : "INTACTO")
    string bottomText = not chartIsIC ? "PDL BLOQUEADO · NO IC" : not showChartPDHPDL ? "PDL DESACTIVADO" : not chartTfSupportsDaily ? "PDL TF NO SOPORTADA" : not dailyDataOK ? "PDL SIN D (verificar datos)" : "PDL " + str.tostring(dailyPDL,format.mintick) + " · " + (chartPdlTaken1D ? "TOMADO" : "INTACTO")
    table.cell(chartDailyPanel,0,1,topText,text_color=not dailyDataOK ? color.orange : chartPdhTaken1D ? color.orange : color.aqua,bgcolor=panelBackground,text_size=size.tiny)
    table.cell(chartDailyPanel,0,2,bottomText,text_color=not dailyDataOK ? color.orange : chartPdlTaken1D ? color.orange : color.fuchsia,bgcolor=panelBackground,text_size=size.tiny)


// V34.12Q H4 FVG: zones reconstructed independently from the
// chart broker native H4 (not from the CRT's M5/NY H4 context).
// Las zonas se calculan arriba usando solo H4 cerradas del ticker.



var line hiLine = na
var line loLine = na
var line m5Line = na
var line m15Line = na
var label hiLabel = na
var label loLabel = na
if barstate.islast
    if showIntegratedChart and showLevels and visible
        int t1 = displayC1
        // Stop drawing after the selected family event window; do not
        // reuse prices from another C1 when the chart is opened.
        int t2 = math.min(time_close, displayEnd)
        color ink = chartCoreHistorical ? color.gray : chartCoreActive and (not qaPhase1NonBtc or chartBtcSymbol) ? color.rgb(168,65,115) : color.orange
        if na(hiLine)
            hiLine := line.new(t1,displayCRH,t2,displayCRH,xloc=xloc.bar_time,color=ink,width=2)
            loLine := line.new(t1,displayCRL,t2,displayCRL,xloc=xloc.bar_time,color=ink,width=2)
            hiLabel := label.new(t2,displayCRH,"CRH "+displayFamily,xloc=xloc.bar_time,style=label.style_label_left,textcolor=ink,color=color.new(color.white,100),size=size.tiny)
            loLabel := label.new(t2,displayCRL,"CRL "+displayFamily,xloc=xloc.bar_time,style=label.style_label_left,textcolor=ink,color=color.new(color.white,100),size=size.tiny)
        line.set_xy1(hiLine,t1,displayCRH)
        line.set_xy2(hiLine,t2,displayCRH)
        line.set_color(hiLine,ink)
        line.set_xy1(loLine,t1,displayCRL)
        line.set_xy2(loLine,t2,displayCRL)
        line.set_color(loLine,ink)
        label.set_xy(hiLabel,t2,displayCRH)
        label.set_text(hiLabel,"CRH "+displayFamily)
        label.set_textcolor(hiLabel,ink)
        label.set_xy(loLabel,t2,displayCRL)
        label.set_text(loLabel,"CRL "+displayFamily)
        label.set_textcolor(loLabel,ink)
        bool extraOwnM5 = chartExtraC1 and showMssLines and not na(own.extraFamilyC1) and own.extraFamilyC1 == own.familyVisual.c1Start and own.extraFamilyKind == own.familyVisual.kind and not na(own.extraFamilyM5C1) and own.extraFamilyM5C1 == own.extraFamilyC1 and not na(own.extraFamilySweepAt) and not na(own.extraFamilyM5PivotAt) and not na(own.extraFamilyM5Pivot) and own.extraFamilyM5PivotAt < own.extraFamilySweepAt and not na(own.extraFamilyM5At) and own.extraFamilyM5At > own.extraFamilySweepAt and own.extraFamilyM5At % MIN5 == own.qaSourcePhaseMin * 60000
        bool coreOwnM5 = chartCoreC1 and showMssLines and not na(own.m5At) and not na(own.m5PivotAt) and own.m5PivotAt < own.m5At and not na(own.m5Level)
        if coreOwnM5 or extraOwnM5
            int own5PivotT = extraOwnM5 ? own.extraFamilyM5PivotAt : own.m5PivotAt
            float own5PivotPrice = extraOwnM5 ? own.extraFamilyM5Pivot : own.m5Level
            int own5BreakT = extraOwnM5 ? own.extraFamilyM5At : own.m5At
            color own5Ink = extraOwnM5 ? color.orange : color.teal
            if na(m5Line)
                m5Line := line.new(own5PivotT,own5PivotPrice,own5BreakT,own5PivotPrice,xloc=xloc.bar_time,color=own5Ink,style=line.style_dashed,width=2)
            line.set_xy1(m5Line,own5PivotT,own5PivotPrice)
            line.set_xy2(m5Line,own5BreakT,own5PivotPrice)
            line.set_color(m5Line,own5Ink)
        else if not na(m5Line)
            line.delete(m5Line)
            m5Line := na
        // Visual independiente: nivel de swing M15 ya CONFIRMADO
        // y congelado ANTES de la barrida C2. Dibujar en naranja
        // mientras espera ruptura por CIERRE M15; no inventar check ✓.
        // Independent Inside/Multi-N M15 pivot, only when selected
        // family identity matches both C1 and kind. No 2C MSS borrowing.
        bool extraOwnM15 = chartExtraC1 and showMssLines and not na(own.extraFamilyC1) and own.extraFamilyC1 == own.familyVisual.c1Start and own.extraFamilyKind == own.familyVisual.kind and not na(own.extraFamilyM15PivotAt) and not na(own.extraFamilyM15Pivot) and not na(own.extraFamilySweepAt) and own.extraFamilyM15PivotAt < own.extraFamilySweepAt
        bool m15SwingAvailable = showMssLines and (chartCoreC1 and own.phase == 2 and not na(own.m15PivotAt) and not na(own.m15Level) and not na(own.sweepAt) and own.m15PivotAt < own.sweepAt or extraOwnM15)
        int shownM15PivotAt = extraOwnM15 ? own.extraFamilyM15PivotAt : own.m15PivotAt
        float shownM15Price = extraOwnM15 ? own.extraFamilyM15Pivot : own.m15Level
        int shownM15SweepAt = extraOwnM15 ? own.extraFamilySweepAt : own.sweepAt
        int shownM15BreakAt = extraOwnM15 ? own.extraFamilyM15At : own.m15At
        bool m15BreakConfirmed = m15SwingAvailable and not na(shownM15BreakAt) and shownM15BreakAt > shownM15SweepAt and f_m15_phase_ok(shownM15BreakAt, own.qaSourcePhaseMin) and not na(own.qaLastClosedM15At) and shownM15BreakAt <= own.qaLastClosedM15At
        if m15SwingAvailable
            int lineEndM15 = m15BreakConfirmed ? shownM15BreakAt : time_close
            color m15Ink = m15BreakConfirmed ? color.blue : color.orange
            if na(m15Line)
                m15Line := line.new(shownM15PivotAt,shownM15Price,lineEndM15,shownM15Price,xloc=xloc.bar_time,color=m15Ink,style=line.style_dashed,width=2)
            line.set_xy1(m15Line,shownM15PivotAt,shownM15Price)
            line.set_xy2(m15Line,lineEndM15,shownM15Price)
            line.set_color(m15Line,m15Ink)
        else if not na(m15Line)
            line.delete(m15Line)
            m15Line := na
    else
        if not na(hiLine)
            line.delete(hiLine)
            hiLine := na
        if not na(loLine)
            line.delete(loLine)
            loLine := na
        if not na(m5Line)
            line.delete(m5Line)
            m5Line := na
        if not na(m15Line)
            line.delete(m15Line)
            m15Line := na
        if not na(hiLabel)
            label.delete(hiLabel)
            hiLabel := na
        if not na(loLabel)
            label.delete(loLabel)
            loLabel := na

    
// V34.12Q: PDH/PDL anterior 1D y estado de mecha de este 1D.
 // Up to 3 own-provider confirmed H4 FVG boxes, separate from CRT.
 // 34 M5 symbols + 1 D + 1 H4 requests on same ticker = 36 <= 40.
 // Motor RTH liquidity preserved internally; no cross-source attribution.
var line pdhChartLine = na
var line pdlChartLine = na
var label pdhChartLabel = na
var label pdlChartLabel = na
var box fvgH4ChartBox1 = na
var label fvgH4ChartLabel1 = na
var box fvgH4ChartBox2 = na
var label fvgH4ChartLabel2 = na
var box fvgH4ChartBox3 = na
var label fvgH4ChartLabel3 = na
if barstate.islast
    [newBox1,newLabel1] = f_drawChartFvg(fvgH4ChartBox1,fvgH4ChartLabel1,drawFvg1,drawFvg1Top,drawFvg1Bottom,drawFvg1At,drawFvg1Dir,drawFvg1Partial,time_close)
    fvgH4ChartBox1 := newBox1
    fvgH4ChartLabel1 := newLabel1
    [newBox2,newLabel2] = f_drawChartFvg(fvgH4ChartBox2,fvgH4ChartLabel2,drawFvg2,drawFvg2Top,drawFvg2Bottom,drawFvg2At,drawFvg2Dir,drawFvg2Partial,time_close)
    fvgH4ChartBox2 := newBox2
    fvgH4ChartLabel2 := newLabel2
    [newBox3,newLabel3] = f_drawChartFvg(fvgH4ChartBox3,fvgH4ChartLabel3,drawFvg3,drawFvg3Top,drawFvg3Bottom,drawFvg3At,drawFvg3Dir,drawFvg3Partial,time_close)
    fvgH4ChartBox3 := newBox3
    fvgH4ChartLabel3 := newLabel3
    if showPDLevels
        int pdStart = dailyNowOpen
        int pdEnd = na(time_close) ? time + timeframe.in_seconds(timeframe.period) * 1000 : time_close
        color pdhInk = chartPdhTaken1D ? color.orange : color.aqua
        color pdlInk = chartPdlTaken1D ? color.orange : color.fuchsia
        if pdEnd > pdStart
            if na(pdhChartLine)
                pdhChartLine := line.new(pdStart,dailyPDH,pdEnd,dailyPDH,xloc=xloc.bar_time,color=pdhInk,style=line.style_dotted,width=1)
                pdlChartLine := line.new(pdStart,dailyPDL,pdEnd,dailyPDL,xloc=xloc.bar_time,color=pdlInk,style=line.style_dotted,width=1)
                pdhChartLabel := label.new(pdEnd,dailyPDH,"PDH 1D QA",xloc=xloc.bar_time,style=label.style_label_left,textcolor=pdhInk,color=color.new(color.black,100),size=size.tiny)
                pdlChartLabel := label.new(pdEnd,dailyPDL,"PDL 1D QA",xloc=xloc.bar_time,style=label.style_label_left,textcolor=pdlInk,color=color.new(color.black,100),size=size.tiny)
            line.set_xy1(pdhChartLine,pdStart,dailyPDH)
            line.set_xy2(pdhChartLine,pdEnd,dailyPDH)
            line.set_color(pdhChartLine,pdhInk)
            line.set_xy1(pdlChartLine,pdStart,dailyPDL)
            line.set_xy2(pdlChartLine,pdEnd,dailyPDL)
            line.set_color(pdlChartLine,pdlInk)
            label.set_xy(pdhChartLabel,pdEnd,dailyPDH)
            label.set_xy(pdlChartLabel,pdEnd,dailyPDL)
            label.set_textcolor(pdhChartLabel,pdhInk)
            label.set_textcolor(pdlChartLabel,pdlInk)
            label.set_text(pdhChartLabel,chartPdhTaken1D ? "PDH TOMADO" : "PDH INTACTO")
            label.set_text(pdlChartLabel,chartPdlTaken1D ? "PDL TOMADO" : "PDL INTACTO")
    else
        if not na(pdhChartLine)
            line.delete(pdhChartLine)
            pdhChartLine := na
        if not na(pdlChartLine)
            line.delete(pdlChartLine)
            pdlChartLine := na
        if not na(pdhChartLabel)
            label.delete(pdhChartLabel)
            pdhChartLabel := na
        if not na(pdlChartLabel)
            label.delete(pdlChartLabel)
            pdlChartLabel := na

