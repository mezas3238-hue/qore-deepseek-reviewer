string[] scanSymbols = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34)
// PROVEEDOR SOBERANO: IC MARKETS en los 34 slots.
// NO sobrescribir BTC con COINBASE, OANDA ni el ticker abierto.
// Ningún input permite modificar estos feeds sin versionar código.
// Labels legibles del inventario FIJO, sin selección de proveedor en ajustes.
f_name(string sym) =>
    int pos = str.pos(sym, ":")
    pos >= 0 ? str.substring(sym, pos + 1) : sym

string[] scanNames = array.from(f_name(s01), f_name(s02), f_name(s03), f_name(s04), "NDX100", f_name(s06), f_name(s07), f_name(s08), f_name(s09), f_name(s10), f_name(s11), f_name(s12), f_name(s13), f_name(s14), f_name(s15), f_name(s16), f_name(s17), f_name(s18), f_name(s19), f_name(s20), f_name(s21), f_name(s22), f_name(s23), f_name(s24), f_name(s25), f_name(s26), f_name(s27), f_name(s28), f_name(s29), f_name(s30), f_name(s31), f_name(s32), f_name(s33), f_name(s34))

// V34.12L QA: default fase M5 por proveedor solo para diagnostico de 34 feeds.
// 26 fuentes +1/+2m siguen siendo CRT QA, NO H4 NY :00 certificadas.
// V34.12K QA: no se hace request.security() adicional para el grafico.
// Reutilizar el Signal completo del SLOT que coincide exactamente con ticker.standard.
// No se dibujan niveles si el proveedor del grafico NO coincide con ninguno de los 34.
Signal integratedOwn = na
int integratedSlot = -1
// El chart tiene un slot propio basado SOLO en ticker+proveedor;
// el valor na de una respuesta Signal no borra Daily ni FVG.
int chartStaticSlot = -1
string integratedChartBroker = ticker.standard(syminfo.tickerid)
// TradingView identifica los graficos oficiales IC Markets con IC:.
// Pine NO puede cambiar el simbolo abierto por el usuario: en otros
// brokers se bloquea el dibujo, con aviso visible. No mezclar precios.
bool chartIsIC = str.upper(syminfo.prefix) == "IC"

// One independent seven-category snapshot per provider/slot. Does NOT
// merge sub-model identities or promote QA state to operational CRT.
var array<int> qaCatalogPerFeed = array.new_int(34, 0)
// V34.11b QA: same-source per-slot causal fields from the EXISTING
// security() result. The last snapshot is not a historical event stream.
var array<int> qaC1BySlot = array.new_int(34, na)
var array<int> qaC2BySlot = array.new_int(34, na)
var array<int> qaSweepBySlot = array.new_int(34, na)
var array<int> qaRatBySlot = array.new_int(34, na)
var array<int> qaPivot15AtBySlot = array.new_int(34, na)
