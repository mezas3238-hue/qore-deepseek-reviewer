string[] scanSymbols = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34)
// Si el gráfico es BTCUSD, el slot BTC usa EXACTAMENTE el
// proveedor del gráfico (p. ej. COINBASE:BTCUSD), también en modo 34.
// Así se evitan dos versiones incompatibles de BTC y un MSS cruzado.
bool btcSameChart = str.upper(syminfo.ticker) == "BTCUSD"
if btcSameChart
    array.set(scanSymbols, 7, syminfo.tickerid)
// Nombres calculados del simbolo ELEGIDO en ajustes. Si se cambia el broker,
// nunca dejamos en pantalla el viejo alias.
f_name(string sym) =>
    int pos = str.pos(sym, ":")
    pos >= 0 ? str.substring(sym, pos + 1) : sym

string[] scanNames = array.from(f_name(s01), f_name(s02), f_name(s03), f_name(s04), f_name(s05), f_name(s06), f_name(s07), f_name(s08), f_name(s09), f_name(s10), f_name(s11), f_name(s12), f_name(s13), f_name(s14), f_name(s15), f_name(s16), f_name(s17), f_name(s18), f_name(s19), f_name(s20), f_name(s21), f_name(s22), f_name(s23), f_name(s24), f_name(s25), f_name(s26), f_name(s27), f_name(s28), f_name(s29), f_name(s30), f_name(s31), f_name(s32), f_name(s33), f_name(s34))

// One independent seven-category snapshot per provider/slot. Does NOT
// merge sub-model identities or promote QA state to operational CRT.
var array<int> qaCatalogPerFeed = array.new_int(34, 0)
// V34.11b QA: same-source per-slot causal fields from the EXISTING
// security() result. The last snapshot is not a historical event stream.
var array<int> qaC1BySlot = array.new_int(34, na)
var array<int> qaC2BySlot = array.new_int(34, na)
var array<int> qaSweepBySlot = array.new_int(34, na)
var array<int> qaRatBySlot = array.new_int(34, na)
var array<int> qaPivot15AtBySlot = array.new_int(34, na)
var array<float> qaPivot15PriceBySlot = array.new_float(34, na)
var array<int> qaBreak15BySlot = array.new_int(34, na)
var array<int> qaClosed15BySlot = array.new_int(34, na)
var array<string> qaExtraKindBySlot = array.new_string(34, "NONE")
var array<int> qaExtraC1BySlot = array.new_int(34, na)
var array<int> qaExtraSweepBySlot = array.new_int(34, na)
var array<int> qaExtraPivot15AtBySlot = array.new_int(34, na)
var array<float> qaExtraPivot15PriceBySlot = array.new_float(34, na)
var array<int> qaExtraBreak15BySlot = array.new_int(34, na)
var array<int> qaExtraRatBySlot = array.new_int(34, na)
var array<int> qaHistCandidate2CBySlot = array.new_int(34, na)
var array<int> qaHistRatified2CBySlot = array.new_int(34, na)
var array<int> qaHistRejectedExpansionBySlot = array.new_int(34, na)
var array<int> qaHistConfirmed3CBySlot = array.new_int(34, na)
var array<int> qaTrue3CSignedBySlot = array.new_int(34, na)
var array<int> qaHistInsideReturnBySlot = array.new_int(34, na)
var array<int> qaHistInsideContinuationBySlot = array.new_int(34, na)
var array<int> qaHistMulti4BySlot = array.new_int(34, na)
var array<int> qaHistMultiNBySlot = array.new_int(34, na)
var array<int> qaHistRetest15BySlot = array.new_int(34, na)
var array<int> statuses = array.new_int(34, -1)
// Estado independiente: fase 2 confirmada + identidad y modelo estructural valido.
// Las fases 1 (provisional) y 3 (historica) nunca entran en Solo CRT.
var array<bool> validCrtFlags = array.new_bool(34, false)
var array<bool> validCoreFlags = array.new_bool(34, false)
// 33 non-BTC feed-phase candidates are observed separately; NOT certified.
var array<bool> qaCoreObservedFlags = array.new_bool(34, false)
var array<string> familyLabels = array.new_string(34, "NONE")
var array<int> directions = array.new_int(34, 0)
var array<int> m5Flags = array.new_int(34, 0)
var array<int> m15Flags = array.new_int(34, 0)
var array<int> extraM15Flags = array.new_int(34, 0)
var array<int> c1IDs = array.new_int(34, 0)
var array<int> m5Times = array.new_int(34, 0)
var array<int> m5PivotTimes = array.new_int(34, na)
var array<int> qaObservedDirectionBySlot = array.new_int(34, 0)
var array<int> qaSourcePhaseBySlot = array.new_int(34, na)
var array<int> m15Times = array.new_int(34, 0)
// V34.10u — Telemetria por feed usando el MISMO Signal del
// escaner. Solo se ve en la vista opt-in; no entra en alertas.
var array<int> auditFeedAvailable = array.new_int(34, 0)
var array<int> auditFeedC1 = array.new_int(34, 0)
var array<int> auditFeedH4Closed = array.new_int(34, 0)
var array<int> auditFeedC1Hours = array.new_int(34, 0)
var array<int> auditFeedC1Clock = array.new_int(34, 0)
var array<int> auditFeedC1Data = array.new_int(34, 0)
var array<int> auditFeedC1Range = array.new_int(34, 0)
var array<int> auditFeed2C = array.new_int(34, 0)
var array<int> auditFeed3C = array.new_int(34, 0)
var array<int> auditFeedInside = array.new_int(34, 0)
var array<int> auditFeedM4 = array.new_int(34, 0)
var array<int> auditFeedMN = array.new_int(34, 0)
var array<int> auditFeedH4StartMis = array.new_int(34, 0)
var array<int> auditFeedH4EndMis = array.new_int(34, 0)
var array<int> auditFeedH4BarsMis = array.new_int(34, 0)
var array<int> auditFeedPhaseMin = array.new_int(34, na)
var array<int> auditFeedH4LastBars = array.new_int(34, na)
var array<int> auditFeedH4StartShift = array.new_int(34, na)
var array<int> auditFeedH4EndShift = array.new_int(34, na)
var array<int> auditFeedH4Gap = array.new_int(34, 0)
var array<int> auditFeedH4DST = array.new_int(34, 0)
var array<int> auditFeedH4Session = array.new_int(34, 0)
var array<int> auditFeedH4Internal = array.new_int(34, 0)
var array<int> auditFeedC2Rejected = array.new_int(34, 0)
var array<int> auditFeedM15QA = array.new_int(34, 0)
var array<string> pdhTexts = array.new_string(34, "N/D")
var array<string> pdlTexts = array.new_string(34, "N/D")
var array<int> pdhFlags = array.new_int(34, -1)
var array<int> pdlFlags = array.new_int(34, -1)
varip array<int> alert5IDs = array.new_int(34, 0)
varip array<int> alert15IDs = array.new_int(34, 0)
int found = 0
int foundQA = 0
int with5 = 0
int with15 = 0
int missing = 0
int checked = 0
// Conteos historicos agregados de los feeds M5 realmente consultados.
int hist2C34 = 0
int hist3C34 = 0
int histInside34 = 0
int histM434 = 0
int histMN34 = 0
int withHistory34 = 0
int familyQA15Count = 0
string alertsNow = ""

for i = 0 to 33
    if scanAll or i == 7
        string symbol = array.get(scanSymbols, i)
        // El UDT cuenta como un campo de retorno, evita 34*12 campos de tupla.
        Signal s = request.security(symbol, "5", f_engine_snapshot(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=1500)
        bool available = not na(s) and not na(s.phase)
        int st = available ? s.phase : 0
        int dr = available ? s.direction : 0
        int id = available and not na(s.c1Start) ? s.c1Start : 0
        int m5t = available and not na(s.m5At) ? s.m5At : 0
        int m15t = available and not na(s.m15At) ? s.m15At : 0
        bool structuralCoreObserved = available and st == 2 and s.isPatternValid and s.modelKind == "CRT_2C_RETURN" and id > 0 and (dr == 1 or dr == -1) and not na(s.sweepAt) and s.sweepAt > s.crtC2Start and not na(s.crtC2Start) and not na(s.crtRatifiedAt) and s.crtRatifiedAt >= s.crtC2Start + H4MS
        // Preserve prior validation gate. Only non-core, exact H4 ratified
        // sources are eligible to have their own MSS evidence shown as QA.
        bool scanCrtValid = structuralCoreObserved and (not qaPhase1NonBtc or i == 7)
        bool observedCoreQA = structuralCoreObserved and not scanCrtValid
        array.set(qaCatalogPerFeed, i, available ? nz(s.qaCatalogMask, 0) : 0)
        array.set(qaC1BySlot, i, available ? s.c1Start : na)
        array.set(qaC2BySlot, i, available ? s.crtC2Start : na)
        array.set(qaSweepBySlot, i, available ? s.sweepAt : na)
        array.set(qaRatBySlot, i, available ? s.crtRatifiedAt : na)
        array.set(qaPivot15AtBySlot, i, available ? s.m15PivotAt : na)
        array.set(qaPivot15PriceBySlot, i, available ? s.m15Level : na)
        array.set(qaBreak15BySlot, i, available ? s.m15At : na)
        array.set(qaClosed15BySlot, i, available ? s.qaLastClosedM15At : na)
        array.set(qaExtraKindBySlot, i, available ? s.extraFamilyKind : "NONE")
        array.set(qaExtraC1BySlot, i, available ? s.extraFamilyC1 : na)
        array.set(qaExtraSweepBySlot, i, available ? s.extraFamilySweepAt : na)
        array.set(qaExtraPivot15AtBySlot, i, available ? s.extraFamilyM15PivotAt : na)
        array.set(qaExtraPivot15PriceBySlot, i, available ? s.extraFamilyM15Pivot : na)
        array.set(qaExtraBreak15BySlot, i, available ? s.extraFamilyM15At : na)
        array.set(qaExtraRatBySlot, i, available ? s.extraFamilyRatifiedAt : na)
        array.set(qaHistCandidate2CBySlot, i, available ? s.qaLastCandidate2CAt : na)
        array.set(qaHistRatified2CBySlot, i, available ? s.qaLastRatified2CAt : na)
        array.set(qaHistRejectedExpansionBySlot, i, available ? s.qaLastRejectedExpansionAt : na)
        array.set(qaHistConfirmed3CBySlot, i, available ? s.qaLastConfirmed3CAt : na)
        array.set(qaTrue3CSignedBySlot, i, available ? s.qaTrue3CSignedAt : na)
        array.set(qaHistInsideReturnBySlot, i, available ? s.qaLastInsideReturnAt : na)
        array.set(qaHistInsideContinuationBySlot, i, available ? s.qaLastInsideContinuationAt : na)
        array.set(qaHistMulti4BySlot, i, available ? s.qaLastMulti4At : na)
        array.set(qaHistMultiNBySlot, i, available ? s.qaLastMultiNAt : na)
        array.set(qaHistRetest15BySlot, i, available ? s.qaLastRetest15At : na)
        array.set(statuses, i, st)
        bool extraValidQA = available and s.extraFamilyValid and not na(s.extraFamilyC1) and s.extraFamilyC1 > 0 and not na(s.extraFamilyRatifiedAt) and (s.extraFamilyDirection == 1 or s.extraFamilyDirection == -1) and (s.extraFamilyKind == "INSIDE QA" or s.extraFamilyKind == "MULTI4 QA" or s.extraFamilyKind == "MULTI-N QA")
        bool anyStructuralCRT = scanCrtValid or extraValidQA
        array.set(validCrtFlags, i, anyStructuralCRT)
        array.set(validCoreFlags, i, scanCrtValid)
        array.set(qaCoreObservedFlags, i, observedCoreQA)
        array.set(familyLabels, i, scanCrtValid ? "3C" : extraValidQA ? s.extraFamilyKind : "NONE")
        array.set(directions, i, scanCrtValid ? dr : extraValidQA ? s.extraFamilyDirection : 0)
        array.set(c1IDs, i, id)
        array.set(m5Flags, i, m5t > 0 ? 1 : 0)
        array.set(m15Flags, i, m15t > 0 ? 1 : 0)
        bool family15QA = extraValidQA and not na(s.extraFamilyC1) and s.extraFamilyM15C1 == s.extraFamilyC1 and not na(s.extraFamilySweepAt) and not na(s.extraFamilyM15PivotAt) and s.extraFamilyM15PivotAt < s.extraFamilySweepAt and not na(s.extraFamilyM15Pivot) and not na(s.extraFamilyM15At) and s.extraFamilyM15At > s.extraFamilySweepAt and f_m15_phase_ok(s.extraFamilyM15At, s.qaSourcePhaseMin) and not na(s.qaLastClosedM15At) and s.extraFamilyM15At <= s.qaLastClosedM15At
        array.set(extraM15Flags, i, family15QA ? 1 : 0)
        array.set(m5Times, i, m5t)
        array.set(m5PivotTimes, i, available ? s.m5PivotAt : na)
        array.set(qaObservedDirectionBySlot, i, available ? dr : 0)
        array.set(qaSourcePhaseBySlot, i, available ? s.qaSourcePhaseMin : na)
        array.set(m15Times, i, m15t)
        string hStatus = available ? s.pdhStatus : "N/D"
        string lStatus = available ? s.pdlStatus : "N/D"
        array.set(pdhFlags, i, hStatus == "N/D" ? -1 : hStatus == "TAKEN" ? 1 : 0)
        array.set(pdlFlags, i, lStatus == "N/D" ? -1 : lStatus == "TAKEN" ? 1 : 0)
        array.set(pdhTexts, i, available ? f_liqText(hStatus, s.pdhSweepAt, s.pdhSweepStage, s.pdhSweepC1, s.c1Start, s.crtC2Start) : "N/D")
        array.set(pdlTexts, i, available ? f_liqText(lStatus, s.pdlSweepAt, s.pdlSweepStage, s.pdlSweepC1, s.c1Start, s.crtC2Start) : "N/D")
        // Identidad del SLOT de feed. Conteos de historial LIMITADO:
        // calc_bars_count=1500 M5, por fuente, no todo el mercado.
        array.set(auditFeedAvailable, i, available ? 1 : 0)
        array.set(auditFeedC1, i, available ? nz(s.qaC1Ready, 0) : 0)
        array.set(auditFeedH4Closed, i, available ? nz(s.auditC1H4Closed, 0) : 0)
        array.set(auditFeedC1Hours, i, available ? nz(s.auditC1HourCandidates, 0) : 0)
        array.set(auditFeedC1Clock, i, available ? nz(s.auditC1BadClock, 0) : 0)
        array.set(auditFeedC1Data, i, available ? nz(s.auditC1BadData, 0) : 0)
        array.set(auditFeedC1Range, i, available ? nz(s.auditC1BadRange, 0) : 0)
        array.set(auditFeed2C, i, available ? nz(s.audit2C, 0) : 0)
        array.set(auditFeed3C, i, available ? nz(s.audit3C, 0) : 0)
        array.set(auditFeedInside, i, available ? nz(s.auditInside, 0) : 0)
        array.set(auditFeedM4, i, available ? nz(s.auditM4, 0) : 0)
        array.set(auditFeedMN, i, available ? nz(s.auditMN, 0) : 0)
        array.set(auditFeedH4StartMis, i, available ? nz(s.qaH4BadStart, 0) : 0)
        array.set(auditFeedH4EndMis, i, available ? nz(s.qaH4BadEnd, 0) : 0)
        array.set(auditFeedH4BarsMis, i, available ? nz(s.qaH4BadBars, 0) : 0)
        array.set(auditFeedPhaseMin, i, available ? s.qaLastM5PhaseMin : na)
        array.set(auditFeedH4LastBars, i, available ? s.qaH4LastBars : na)
        array.set(auditFeedH4StartShift, i, available ? s.qaH4LastStartOffsetMin : na)
        array.set(auditFeedH4EndShift, i, available ? s.qaH4LastEndOffsetMin : na)
        array.set(auditFeedH4Gap, i, available ? nz(s.auditH4Incomplete, 0) : 0)
        array.set(auditFeedH4DST, i, available ? nz(s.auditH4DST, 0) : 0)
        array.set(auditFeedH4Session, i, available ? nz(s.auditH4Session, 0) : 0)
        array.set(auditFeedH4Internal, i, available ? nz(s.auditH4Internal, 0) : 0)
        int c2RejectSum = available ? nz(s.auditC2Data, 0) + nz(s.auditC2Double, 0) + nz(s.auditC2NoSweep, 0) + nz(s.auditC2Outside, 0) + nz(s.auditC2Hour, 0) : 0
        array.set(auditFeedC2Rejected, i, c2RejectSum)
        array.set(auditFeedM15QA, i, family15QA ? 1 : 0)
        if not available
            missing += 1
        else
            checked += 1
            int h2 = nz(s.audit2C, 0)
            int h3 = nz(s.audit3C, 0)
            int hi = nz(s.auditInside, 0)
            int hm4 = nz(s.auditM4, 0)
            int hmn = nz(s.auditMN, 0)
            hist2C34 += h2
            hist3C34 += h3
            histInside34 += hi
            histM434 += hm4
            histMN34 += hmn
            if h2 + h3 + hi + hm4 + hmn > 0
                withHistory34 += 1
            if family15QA
                familyQA15Count += 1
        if scanCrtValid
            found += 1
        if extraValidQA and not scanCrtValid
            foundQA += 1
        if scanCrtValid
            if m5t > 0
                with5 += 1
            if m15t > 0
                with15 += 1
            // No alertar CRT provisional (st==1) ni historial (st==3).
            // MSS observado durante C2 se hace elegible al confirmar la H4 (inicio C3).
            // Una confirmacion nueva en C3 conserva el timestamp real de su MSS.
            bool certifiedCRT = (not qaPhase1NonBtc or i == 7) and st == 2 and id > 0 and not na(s.crtC2Start) and not na(s.crtRatifiedAt)
            bool validM5 = certifiedCRT and m5t >= s.crtC2Start
            bool validM15 = certifiedCRT and m15t >= s.crtC2Start
            int eligibleM5At = validM5 ? math.max(m5t, s.crtRatifiedAt) : na
            int eligibleM15At = validM15 ? math.max(m15t, s.crtRatifiedAt) : na
            bool alert5 = validM5 and array.get(alert5IDs, i) != id and timenow >= eligibleM5At and timenow - eligibleM5At <= alertFreshMinutes * 60000
            bool alert15 = validM15 and array.get(alert15IDs, i) != id and timenow >= eligibleM15At and timenow - eligibleM15At <= alertFreshMinutes * 60000
            if useAlerts and not qaPhase1NonBtc and barstate.isrealtime and alert5
                alertsNow += array.get(scanNames,i) + " " + (dr > 0 ? "BULLISH" : "BEARISH") + " MSS M5 | "
                array.set(alert5IDs, i, id)
            if useAlerts and not qaPhase1NonBtc and barstate.isrealtime and alert15
                alertsNow += array.get(scanNames,i) + " " + (dr > 0 ? "BULLISH" : "BEARISH") + " MSS M15 | "
                array.set(alert15IDs, i, id)

if str.length(alertsNow) > 0
    // Permite eventos distintos dentro de una vela del grafico; varip evita reenvio por tick.
    alert("CRT+MSS " + alertsNow, alert.freq_all)

// ---- Grafico: 35a solicitud total, independiente de los 34 feeds ----
Signal own = request.security(syminfo.tickerid, "5", f_engine_snapshot(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=1500)
// QA BTC D: referencia directa de la ULTIMA vela diaria cerrada del
// MISMO PROVEEDOR DEL GRAFICO, no el dia civil NY del modulo anterior.
// high[1]/low[1] + lookahead_on es un patrón sin future leak.
// En historico la vela D actual NUNCA contamina esta referencia.
// Una sola solicitud tuple, independiente de los 34 instrumentos.
[chartPrevDHigh, chartPrevDLow, chartPrevDOpenAt, chartPrevDCloseAt] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1], time_close[1]], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=7)
bool chartBtcSymbol = str.upper(syminfo.ticker) == "BTCUSD"
bool chartTfForDailyComparison = timeframe.isintraday or (timeframe.isdaily and timeframe.multiplier == 1)
bool chartPrevDAvailable = chartBtcSymbol and chartTfForDailyComparison and not na(chartPrevDHigh) and not na(chartPrevDLow) and not na(chartPrevDOpenAt) and not na(chartPrevDCloseAt) and chartPrevDHigh >= chartPrevDLow
// La última 1D cerrada es la única fuente de los precios PDH/PDL
// operativos de BTC. Requerir que las M5 cerradas actuales empiecen
// EXACTAMENTE donde terminó esa 1D, sin lagunas entre M5.
bool chartDayAuditReady = chartPrevDAvailable and not na(own) and own.chartDayContinuous and own.chartDStart == chartPrevDCloseAt and not na(own.chartDayHighM5) and not na(own.chartDayLowM5)
bool chartPdhTaken = chartDayAuditReady and own.chartDayHighM5 > chartPrevDHigh
bool chartPdlTaken = chartDayAuditReady and own.chartDayLowM5 < chartPrevDLow
string chartPdhState = not chartDayAuditReady ? "N/D" : chartPdhTaken ? "TAKEN" : "INTACTO"
string chartPdlState = not chartDayAuditReady ? "N/D" : chartPdlTaken ? "TAKEN" : "INTACTO"
// El simbolo abierto NUNCA se ignora: se calcula aunque no pertenezca a
// los 34 feeds. Si ya existe con el mismo proveedor, no se muestra duplicado.
string ownStd = ticker.standard(syminfo.tickerid)
bool chartInScan = false
for i = 0 to 33
    if ticker.standard(array.get(scanSymbols, i)) == ownStd
        chartInScan := true
bool chartAvailable = not na(own) and not na(own.phase)
bool chartActive = chartAvailable and own.phase > 0
string openName = f_name(syminfo.tickerid)
// V34.10x: never draw a provisional C2 as a certified CRT H4.
bool visualChartAligned = timeframe.isintraday and (timeframe.multiplier == 5 or timeframe.multiplier == 15 or (timeframe.multiplier == 240 and chartAvailable and not na(own.nyH4Start) and own.nyH4Start == time))
// A NY-anchored H4 CRT cannot be placed on a broker H4 chart whose candles
// open at different timestamps. Use chart M5/M15 or an aligned H4 feed.
// 2C and QA 2C keep their original C1, distinct models use the
// bounded familyVisual with OHLC from THAT family's C1 only.
bool chartCoreC1 = chartAvailable and own.phase == 2 and own.isPatternValid and own.modelKind == "CRT_2C_RETURN" and not na(own.c1Start) and not na(own.crtC2Start) and not na(own.crtRatifiedAt) and own.crtRatifiedAt >= own.crtC2Start + H4MS and not na(own.crh) and not na(own.crl) and own.crh > own.crl
bool chartExtraC1 = chartAvailable and not chartCoreC1 and not na(own.familyVisual) and own.familyVisual.structuralQA and not na(own.familyVisual.c1Start) and not na(own.familyVisual.eventClosedAt) and not na(own.familyVisual.c1High) and not na(own.familyVisual.c1Low) and own.familyVisual.c1High > own.familyVisual.c1Low
bool visible = visualChartAligned and (chartCoreC1 or chartExtraC1)
int displayC1 = chartCoreC1 ? own.c1Start : chartExtraC1 ? own.familyVisual.c1Start : na
float displayCRH = chartCoreC1 ? own.crh : chartExtraC1 ? own.familyVisual.c1High : na
float displayCRL = chartCoreC1 ? own.crl : chartExtraC1 ? own.familyVisual.c1Low : na
string displayFamily = chartCoreC1 ? ((not qaPhase1NonBtc or chartBtcSymbol) ? "2C RAT" : "2C QA") : chartExtraC1 ? own.familyVisual.kind : "NONE"
int displayEnd = chartCoreC1 ? own.c1Start + 3 * H4MS : chartExtraC1 ? own.familyVisual.eventClosedAt + H4MS : na
plot(visible ? displayCRH : na, "CRH actual", color=color.new(color.orange, 100), display=display.data_window)
plot(visible ? displayCRL : na, "CRL actual", color=color.new(color.orange, 100), display=display.data_window)
// QA NY: estos valores son del motor M5, no de la H4 visual del broker.
plot(chartAvailable and not na(own.nyH4Start) ? own.nyH4Start / 60000.0 : na, title="QA BTC H4 NY inicio UTC min", display=display.data_window)
plot(chartAvailable ? own.nyH4M5Count : na, title="QA BTC H4 M5 cerradas", display=display.data_window)
plot(chartAvailable ? own.qaC1Ready : na, title="QA C1 NY elegibles historial M5 mismo feed", display=display.data_window)
plot(chartAvailable ? own.qaC2Ratified : na, title="QA BTC CRT C2 ratificados en historial M5", display=display.data_window)
plot(chartAvailable ? own.qaCurrentH4Hour : na, title="QA BTC H4 hora local NY", display=display.data_window)
plot(chartAvailable ? own.nyPDH : na, title="QA BTC PDH NY nivel", display=display.data_window)
plot(chartAvailable ? own.nyPDL : na, title="QA BTC PDL NY nivel", display=display.data_window)
plot(chartAvailable and not na(own.nyPDHReferenceAt) ? own.nyPDHReferenceAt / 60000.0 : na, title="QA BTC PDH PDL NY referencia UTC min", display=display.data_window)
// Contraste directo con la vela diaria visible del mismo ticker.
plot(chartPrevDAvailable ? chartPrevDHigh : na, title="QA BTC PDH 1D GRAFICO precio", display=display.data_window)
plot(chartPrevDAvailable ? chartPrevDLow : na, title="QA BTC PDL 1D GRAFICO precio", display=display.data_window)
plot(chartPrevDAvailable ? chartPrevDOpenAt / 60000.0 : na, title="QA BTC D proveedor inicio UTC min", display=display.data_window)
plot(chartPrevDAvailable ? chartPrevDCloseAt / 60000.0 : na, title="QA BTC D proveedor cierre UTC min", display=display.data_window)
plot(chartDayAuditReady ? own.chartDayHighM5 : na, title="QA BTC D actual maximo M5 cerradas", display=display.data_window)
plot(chartDayAuditReady ? own.chartDayLowM5 : na, title="QA BTC D actual minimo M5 cerradas", display=display.data_window)
plot(chartDayAuditReady ? (chartPdhTaken ? 1 : 0) : na, title="QA BTC PDH 1D tomada 1 intacta 0", display=display.data_window)
plot(chartDayAuditReady ? (chartPdlTaken ? 1 : 0) : na, title="QA BTC PDL 1D tomada 1 intacta 0", display=display.data_window)
var line hiLine = na
var line loLine = na
var line m5Line = na
var line m15Line = na
var label hiLabel = na
var label loLabel = na
// Diagnostico del mismo motor que alimenta el dashboard.
plot(not na(own) ? own.phase : na, title="AUDIT estado CRT grafico (1=provisional 2=activo 3=ultimo)", display=display.data_window)
plot(not na(own) ? own.direction : na, title="AUDIT direccion CRT grafico (+1/-1)", display=display.data_window)
plot(not na(own) ? own.c1Start : na, title="AUDIT ID C1 (timestamp)", display=display.data_window)
// QA CRT CICLO: trazas de identidad y pivotes, solo ventana de datos.
// Los timestamps son minutos UTC desde 1970; multiplicar por 60000 para milisegundos.
plot(chartAvailable and not na(own.c1Start) ? own.c1Start / 60000.0 : na, title="QA CRT C1 inicio UTC min", display=display.data_window)
plot(chartAvailable and not na(own.crtC2Start) ? own.crtC2Start / 60000.0 : na, title="QA CRT C2 inicio UTC min", display=display.data_window)
plot(chartAvailable and not na(own.crtRatifiedAt) ? own.crtRatifiedAt / 60000.0 : na, title="QA CRT C2 ratificacion UTC min", display=display.data_window)
plot(chartAvailable and not na(own.sweepAt) ? own.sweepAt / 60000.0 : na, title="QA CRT barrida C2 fin UTC min", display=display.data_window)
plot(chartAvailable ? own.m5Level : na, title="QA CRT MSS M5 pivote precio", display=display.data_window)
plot(chartAvailable and not na(own.m5PivotAt) ? own.m5PivotAt / 60000.0 : na, title="QA CRT MSS M5 pivote UTC min", display=display.data_window)
plot(chartAvailable and not na(own.m5At) ? own.m5At / 60000.0 : na, title="QA CRT MSS M5 ruptura UTC min", display=display.data_window)
plot(chartAvailable ? own.m15Level : na, title="QA CRT MSS M15 pivote precio", display=display.data_window)
plot(chartAvailable and not na(own.m15PivotAt) ? own.m15PivotAt / 60000.0 : na, title="QA CRT MSS M15 pivote UTC min", display=display.data_window)
plot(chartAvailable and not na(own.m15At) ? own.m15At / 60000.0 : na, title="QA CRT MSS M15 ruptura UTC min", display=display.data_window)
plot(chartAvailable and not na(own.qaLastClosedM15At) ? own.qaLastClosedM15At / 60000.0 : na, title="QA MSS M15 ultima vela cerrada UTC min", display=display.data_window)
plot(chartAvailable ? own.qaCatalogMask : na, title="QA catalogo 7 categorias mascara grafico 1-127", display=display.data_window)
// Exponer momento confirmado separado del dibujo M5, no inventar entrada.
plot(chartAvailable and not na(own.entryConfirmedAt) ? own.entryConfirmedAt / 60000.0 : na, title="QA CRT modelo entrada confirmado UTC min", display=display.data_window)
plot(chartAvailable and not na(own.multi4DetectedAt) ? own.multi4DetectedAt / 60000.0 : na, title="QA CRT MULTI4 cierre cuarta H4 UTC min", display=display.data_window)
plot(chartAvailable and not na(own.retest15At) ? own.retest15At / 60000.0 : na, title="QA CRT RETEST M15 cierre UTC min", display=display.data_window)
plot(chartAvailable ? own.retest15High : na, title="QA CRT RETEST M15 vela maximo", display=display.data_window)
plot(chartAvailable ? own.retest15Low : na, title="QA CRT RETEST M15 vela minimo", display=display.data_window)
plot(chartAvailable ? own.retest15Close : na, title="QA CRT RETEST M15 vela cierre precio", display=display.data_window)
plot(chartAvailable ? own.retest15Pivot : na, title="QA CRT RETEST M15 pivote congelado", display=display.data_window)
plot(chartAvailable and not na(own.m15At) ? own.m15At / 60000.0 : na, title="QA BTC MSS15 validado por M15 UTC min", display=display.data_window)
plot(chartAvailable and not na(own.extraFamilyC1) ? own.extraFamilyC1 / 60000.0 : na, title="QA familia extra C1 UTC min", display=display.data_window)
plot(chartAvailable and not na(own.extraFamilySweepAt) ? own.extraFamilySweepAt / 60000.0 : na, title="QA familia extra barrida M5 fin UTC min", display=display.data_window)
plot(chartAvailable and not na(own.extraFamilyM15PivotAt) ? own.extraFamilyM15PivotAt / 60000.0 : na, title="QA familia extra pivot M15 inicio UTC min", display=display.data_window)
plot(chartAvailable ? own.extraFamilyM15Pivot : na, title="QA familia extra pivot M15 precio", display=display.data_window)
plot(chartAvailable and not na(own.extraFamilyM15At) ? own.extraFamilyM15At / 60000.0 : na, title="QA familia extra MSS M15 cierre UTC min", display=display.data_window)
// FIN QA CRT CICLO
// QA SOLO: valores exportables en ventana de datos; sin nuevos dibujos de chart.
// Estados -1=ausente, 0=INTACTO, 1=PARCIAL, 2=LLENADO_TOTAL, 3=INVALIDADO, 4=DATOS_INCOMPLETOS.
plot(showFvgAudit and chartAvailable ? own.fvgH1Count : na, title="QA FVG H1 cantidad", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH1StateCode : na, title="QA FVG H1 estado", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH1Top : na, title="QA FVG H1 techo", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH1Bottom : na, title="QA FVG H1 suelo", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH1Pen : na, title="QA FVG H1 penetracion %", display=display.data_window)
plot(showFvgAudit and chartAvailable and not na(own.fvgH1FormAt) ? own.fvgH1FormAt / 60000.0 : na, title="QA FVG H1 formedAt UTC min", display=display.data_window)
plot(showFvgAudit and chartAvailable and not na(own.fvgH1GapAt) ? own.fvgH1GapAt / 60000.0 : na, title="QA FVG H1 gapAt UTC min", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH4Count : na, title="QA FVG H4 cantidad", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH4StateCode : na, title="QA FVG H4 estado", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH4Top : na, title="QA FVG H4 techo", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH4Bottom : na, title="QA FVG H4 suelo", display=display.data_window)
plot(showFvgAudit and chartAvailable ? own.fvgH4Pen : na, title="QA FVG H4 penetracion %", display=display.data_window)
plot(showFvgAudit and chartAvailable and not na(own.fvgH4FormAt) ? own.fvgH4FormAt / 60000.0 : na, title="QA FVG H4 formedAt UTC min", display=display.data_window)
plot(showFvgAudit and chartAvailable and not na(own.fvgH4GapAt) ? own.fvgH4GapAt / 60000.0 : na, title="QA FVG H4 gapAt UTC min", display=display.data_window)
if barstate.islast
    if showLevels and visible
        int t1 = displayC1
        // Stop drawing after the selected family event window; do not
        // reuse prices from another C1 when the chart is opened.
        int t2 = math.min(time_close, displayEnd)
        color ink = chartCoreC1 and (not qaPhase1NonBtc or chartBtcSymbol) ? color.rgb(168,65,115) : color.orange
        if na(hiLine)
            hiLine := line.new(t1,displayCRH,t2,displayCRH,xloc=xloc.bar_time,color=ink,width=2)
            loLine := line.new(t1,displayCRL,t2,displayCRL,xloc=xloc.bar_time,color=ink,width=2)
            hiLabel := label.new(t2,displayCRH,"CRH "+displayFamily,xloc=xloc.bar_time,style=label.style_label_left,textcolor=ink,color=color.new(color.white,100),size=size.tiny)
            loLabel := label.new(t2,displayCRL,"CRL "+displayFamily,xloc=xloc.bar_time,style=label.style_label_left,textcolor=ink,color=color.new(color.white,100),size=size.tiny)
        line.set_xy1(hiLine,t1,displayCRH)
        line.set_xy2(hiLine,t2,displayCRH)
        line.set_color(hiLine,ink)
        line.set_xy1(loLine,t1,displayCRL)
        line.set_xy2(loLine,t2,displayCRL)
        line.set_color(loLine,ink)
        label.set_xy(hiLabel,t2,displayCRH)
        label.set_text(hiLabel,"CRH "+displayFamily)
        label.set_textcolor(hiLabel,ink)
        label.set_xy(loLabel,t2,displayCRL)
        label.set_text(loLabel,"CRL "+displayFamily)
        label.set_textcolor(loLabel,ink)
        if chartCoreC1 and showMssLines and not na(own.m5At) and not na(own.m5PivotAt) and own.m5PivotAt < own.m5At and not na(own.m5Level)
            if na(m5Line)
                m5Line := line.new(own.m5PivotAt,own.m5Level,own.m5At,own.m5Level,xloc=xloc.bar_time,color=color.teal,style=line.style_dashed,width=2)
            line.set_xy1(m5Line,own.m5PivotAt,own.m5Level)
            line.set_xy2(m5Line,own.m5At,own.m5Level)
        else if not na(m5Line)
            line.delete(m5Line)
            m5Line := na
        // Visual independiente: nivel de swing M15 ya CONFIRMADO
        // y congelado ANTES de la barrida C2. Dibujar en naranja
        // mientras espera ruptura por CIERRE M15; no inventar check ✓.
        // Independent Inside/Multi-N M15 pivot, only when selected
        // family identity matches both C1 and kind. No 2C MSS borrowing.
        bool extraOwnM15 = chartExtraC1 and showMssLines and not na(own.extraFamilyC1) and own.extraFamilyC1 == own.familyVisual.c1Start and own.extraFamilyKind == own.familyVisual.kind and not na(own.extraFamilyM15PivotAt) and not na(own.extraFamilyM15Pivot) and not na(own.extraFamilySweepAt) and own.extraFamilyM15PivotAt < own.extraFamilySweepAt
        bool m15SwingAvailable = showMssLines and (chartCoreC1 and own.phase == 2 and not na(own.m15PivotAt) and not na(own.m15Level) and not na(own.sweepAt) and own.m15PivotAt < own.sweepAt or extraOwnM15)
        int shownM15PivotAt = extraOwnM15 ? own.extraFamilyM15PivotAt : own.m15PivotAt
        float shownM15Price = extraOwnM15 ? own.extraFamilyM15Pivot : own.m15Level
        int shownM15SweepAt = extraOwnM15 ? own.extraFamilySweepAt : own.sweepAt
        int shownM15BreakAt = extraOwnM15 ? own.extraFamilyM15At : own.m15At
        bool m15BreakConfirmed = m15SwingAvailable and not na(shownM15BreakAt) and shownM15BreakAt > shownM15SweepAt and f_m15_phase_ok(shownM15BreakAt, own.qaSourcePhaseMin) and not na(own.qaLastClosedM15At) and shownM15BreakAt <= own.qaLastClosedM15At
        if m15SwingAvailable
            int lineEndM15 = m15BreakConfirmed ? shownM15BreakAt : time_close
            color m15Ink = m15BreakConfirmed ? color.blue : color.orange
            if na(m15Line)
                m15Line := line.new(shownM15PivotAt,shownM15Price,lineEndM15,shownM15Price,xloc=xloc.bar_time,color=m15Ink,style=line.style_dashed,width=2)
            line.set_xy1(m15Line,shownM15PivotAt,shownM15Price)
            line.set_xy2(m15Line,lineEndM15,shownM15Price)
            line.set_color(m15Line,m15Ink)
        else if not na(m15Line)
            line.delete(m15Line)
            m15Line := na
    else
        if not na(hiLine)
            line.delete(hiLine)
            hiLine := na
        if not na(loLine)
            line.delete(loLine)
            loLine := na
        if not na(m5Line)
            line.delete(m5Line)
            m5Line := na
        if not na(m15Line)
            line.delete(m15Line)
            m15Line := na
        if not na(hiLabel)
            label.delete(hiLabel)
            hiLabel := na
        if not na(loLabel)
            label.delete(loLabel)
            loLabel := na

// ---- DASHBOARD M4B: FILA DEL GRAFICO, PAGINACION Y MSS CONSERVADOS ----
// Seis columnas; 15 filas reservadas (encabezado, 12 datos, 2 pies).
var table board = table.new(position.top_right,6,15,frame_color=color.new(color.gray,70),frame_width=1,border_width=0)
color navy = color.rgb(24,36,56)
color shade = color.rgb(33,44,62)
color posInk = color.rgb(65,190,138)
color negInk = color.rgb(240,113,108)
if barstate.islast
    table.clear(board,0,0,5,14)
    if showDashboard and not compactMobile
        table.cell(board,0,0,"ACTIVO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,0,"CRT H4",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,0,chartBtcSymbol ? "PDH 1D" : "PDH",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,0,chartBtcSymbol ? "PDL 1D" : "PDL",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,0,"MSS M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,0,"MSS M15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        bool allMode = modeDashboard == "Todos los instrumentos"
        bool showHistoricAudit = modeDashboard == "Auditoría histórica (QA)"
        bool showPerFeedAudit = modeDashboard == "Auditoría 34 por símbolo (QA)"
        bool showC1Audit = modeDashboard == "Auditoría C1 34 (QA)"
        bool showQAInList = modeDashboard == "Solo CRT + QA" or allMode
        bool ownCRTValid = (not qaPhase1NonBtc or chartBtcSymbol) and chartAvailable and own.phase == 2 and own.isPatternValid and own.modelKind == "CRT_2C_RETURN" and not na(own.c1Start) and not na(own.crtC2Start) and not na(own.crtRatifiedAt) and own.crtRatifiedAt >= own.crtC2Start + H4MS
        bool m15CRTConfirmed = ownCRTValid and not na(own.m15At) and not na(own.m15PivotAt) and not na(own.m15Level) and not na(own.sweepAt) and own.m15PivotAt < own.sweepAt and own.m15At > own.sweepAt and f_m15_phase_ok(own.m15At, own.qaSourcePhaseMin) and not na(own.qaLastClosedM15At) and own.m15At <= own.qaLastClosedM15At
        bool ownExtraQA = chartAvailable and own.extraFamilyValid and not na(own.extraFamilyRatifiedAt) and not na(own.extraFamilyC1) and own.extraFamilyC1 > 0 and (own.extraFamilyDirection == 1 or own.extraFamilyDirection == -1)
        bool ownChartFamilyQA = chartExtraC1 and not ownCRTValid
        bool ownAnyCRT = ownCRTValid or chartCoreC1 or ownChartFamilyQA
        bool ownFamilyM15QA = ownExtraQA and own.extraFamilyM15C1 == own.extraFamilyC1 and not na(own.extraFamilyM15Pivot) and not na(own.extraFamilyM15PivotAt) and not na(own.extraFamilySweepAt) and not na(own.extraFamilyM15At) and own.extraFamilyM15PivotAt < own.extraFamilySweepAt and own.extraFamilyM15At > own.extraFamilySweepAt and own.extraFamilyM15At <= own.qaLastClosedM15At
        // No atribuir MSS del CRT principal a Inside/Multi4 QA.
        // Activo abierto SIEMPRE en la primera fila, sin duplicados.
        int ownDir = chartCoreC1 ? own.direction : ownChartFamilyQA ? own.familyVisual.direction : 0
        string ownState = ownCRTValid ? (ownDir > 0 ? "[2C] ALC" : "[2C] BAJ") : chartCoreC1 ? (ownDir > 0 ? "[2C QA] ALC" : "[2C QA] BAJ") : ownChartFamilyQA ? "[" + own.familyVisual.kind + "] " + (ownDir > 0 ? "ALC" : "BAJ") : "—"
        color ownInk = ownCRTValid ? (ownDir > 0 ? posInk : negInk) : ownAnyCRT ? color.orange : color.gray
        string ownPDH = chartBtcSymbol ? (chartPdhState == "TAKEN" ? "T 1D" : chartPdhState == "INTACTO" ? "INT" : "N/D") : chartAvailable ? f_liqText(own.pdhStatus,own.pdhSweepAt,own.pdhSweepStage,own.pdhSweepC1,own.c1Start,own.crtC2Start) : "N/D"
        string ownPDL = chartBtcSymbol ? (chartPdlState == "TAKEN" ? "T 1D" : chartPdlState == "INTACTO" ? "INT" : "N/D") : chartAvailable ? f_liqText(own.pdlStatus,own.pdlSweepAt,own.pdlSweepStage,own.pdlSweepC1,own.c1Start,own.crtC2Start) : "N/D"
        // Mostrar el símbolo del gráfico solo cuando sea un CRT estructural H4 ratificado y vigente.
        table.cell(board,0,1,ownAnyCRT ? openName+" [G]" : "ESPERA CRT",bgcolor=shade,text_color=ownAnyCRT ? color.white : color.gray,text_size=size.tiny)
        table.cell(board,1,1,ownState,bgcolor=shade,text_color=ownInk,text_size=size.tiny)
        table.cell(board,2,1,ownCRTValid ? ownPDH : "—",bgcolor=shade,text_color=ownCRTValid ? (chartBtcSymbol ? f_liqColor(chartPdhState) : f_liqColor(own.pdhStatus)) : color.gray,text_size=size.tiny)
        table.cell(board,3,1,ownCRTValid ? ownPDL : "—",bgcolor=shade,text_color=ownCRTValid ? (chartBtcSymbol ? f_liqColor(chartPdlState) : f_liqColor(own.pdlStatus)) : color.gray,text_size=size.tiny)
        table.cell(board,4,1,ownCRTValid and not na(own.m5At) ? "✓" : "—",bgcolor=shade,text_color=ownCRTValid and not na(own.m5At) ? posInk : color.gray,text_size=size.small)
        table.cell(board,5,1,m15CRTConfirmed ? "✓" : showQAInList and ownFamilyM15QA and not ownCRTValid ? "M15 QA" : "—",bgcolor=shade,text_color=m15CRTConfirmed or showQAInList and ownFamilyM15QA and not ownCRTValid ? posInk : color.gray,text_size=size.tiny)

        // El catalogo CRT del instrumento ABIERTO tambien sirve en
        // Forex, indices y metales: reservar filas 4,5,6 en todos ellos.
        // La paginacion de hasta 34 permite recorrer los demas resultados.
        int maxOtherRows = showEntryCatalog ? 2 : 5
        int othersOnPage = math.max(1,math.min(rowsToShow-1,maxOtherRows))
        int offset = (page-1)*othersOnPage
        int passed = 0
        int shown = 0
        for i = 0 to 33
            string sym = array.get(scanSymbols,i)
            bool sameAsChart = ticker.standard(sym) == ownStd
            bool slotScanned = scanAll or i == 7
            int st = array.get(statuses,i)
            bool validMain = array.get(validCoreFlags,i)
            bool qa2C = array.get(qaCoreObservedFlags,i)
            int qaMask = array.get(qaCatalogPerFeed,i)
            bool real3cQA = int(math.floor(qaMask / 1)) % 2 == 1 and not validMain and not qa2C
            bool hasCRT = array.get(validCrtFlags,i) or qa2C or real3cQA
            string familyLabel = array.get(familyLabels,i)
            if slotScanned and not sameAsChart and (allMode or hasCRT)
                if passed >= offset and shown < othersOnPage
                    int r = shown+2
                    int signedC3 = array.get(qaTrue3CSignedBySlot,i)
                    int dir = real3cQA and not na(signedC3) ? signedC3 > 0 ? 1 : -1 : qa2C ? array.get(qaObservedDirectionBySlot,i) : array.get(directions,i)
                    color rowbg = r % 2 == 0 ? navy : shade
                    color dirInk = hasCRT ? (validMain ? (dir > 0 ? posInk : negInk) : color.orange) : color.gray
                    string familyTag = validMain ? "[2C] " : qa2C ? "[2C QA] " : real3cQA ? "[3C QA] " : familyLabel == "INSIDE QA" ? "[INS QA] " : familyLabel == "MULTI-N QA" ? "[MN QA] " : "[M4 QA] "
                    string side = not hasCRT ? "—" : familyTag + (dir > 0 ? "ALC" : dir < 0 ? "BAJ" : "DIR N/V")
                    table.cell(board,0,r,array.get(scanNames,i),bgcolor=rowbg,text_color=color.white,text_size=size.tiny)
                    table.cell(board,1,r,side,bgcolor=rowbg,text_color=dirInk,text_size=size.tiny)
                    int hFlag = array.get(pdhFlags,i)
                    int lFlag = array.get(pdlFlags,i)
                    table.cell(board,2,r,array.get(pdhTexts,i),bgcolor=rowbg,text_color=hFlag == 1 ? color.rgb(237,164,83) : hFlag == 0 ? color.rgb(97,192,152) : color.gray,text_size=size.tiny)
                    table.cell(board,3,r,array.get(pdlTexts,i),bgcolor=rowbg,text_color=lFlag == 1 ? color.rgb(237,164,83) : lFlag == 0 ? color.rgb(97,192,152) : color.gray,text_size=size.tiny)
                    table.cell(board,4,r,validMain and array.get(m5Flags,i)==1 ? "✓" : "—",bgcolor=rowbg,text_color=validMain and array.get(m5Flags,i)==1 ? posInk : color.gray,text_size=size.small)
                    bool extraConfirmedM15 = not validMain and showQAInList and array.get(extraM15Flags,i) == 1
                    table.cell(board,5,r,validMain and array.get(m15Flags,i)==1 ? "✓" : extraConfirmedM15 ? "M15 QA" : "—",bgcolor=rowbg,text_color=validMain and array.get(m15Flags,i)==1 or extraConfirmedM15 ? posInk : color.gray,text_size=size.tiny)
                    shown += 1
                passed += 1
        if shown == 0 and passed == 0
            table.cell(board,0,2,allMode ? "SIN DATOS" : "SIN CRT VIGENTE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        // Fila 10: REFERENCIA del propio proveedor para la vela 1D previa.
        // Una referencia de NY y una de 1D pueden tener precios distintos.
        string dChartStart = chartPrevDAvailable ? str.format_time(chartPrevDOpenAt, "dd/MM HH:mm", syminfo.timezone) : "N/D"
        string dChartClose = chartPrevDAvailable ? str.format_time(chartPrevDCloseAt, "dd/MM HH:mm", syminfo.timezone) : "N/D"
        // EVIDENCIA RETEST: una fila para el cierre exacto y precios guardados
        // de LA vela M15 que produjo la observacion, no la ultima M15 del panel.
        if showEntryCatalog
            bool rtAvailable = chartAvailable and own.retest15State == "RETEST M15 QA" and not na(own.retest15At) and not na(own.m15At) and own.retest15At > own.m15At and not na(own.retest15Pivot) and own.retest15Pivot == own.m15Level
            bool rtOHLC = rtAvailable and not na(own.retest15High) and not na(own.retest15Low) and not na(own.retest15Close) and (own.direction == 1 ? own.retest15Low <= own.retest15Pivot and own.retest15Close > own.retest15Pivot : own.direction == -1 ? own.retest15High >= own.retest15Pivot and own.retest15Close < own.retest15Pivot : false)
            table.cell(board,0,4,"RETEST M15",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,4,rtOHLC ? str.format_time(own.retest15At,"dd/MM HH:mm",TZ) : "ESPERA",bgcolor=shade,text_color=rtOHLC ? posInk : color.gray,text_size=size.tiny)
            table.cell(board,2,4,rtOHLC ? "P:"+str.tostring(own.retest15Pivot,format.mintick) : "P:N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,3,4,rtOHLC ? (own.direction > 0 ? "L:" : "H:")+str.tostring(own.direction > 0 ? own.retest15Low : own.retest15High,format.mintick) : "H/L:N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,4,4,rtOHLC ? "C:"+str.tostring(own.retest15Close,format.mintick) : "C:N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,5,4,rtOHLC ? "TOQUE QA" : "SIN RT QA",bgcolor=shade,text_color=rtOHLC ? posInk : color.orange,text_size=size.tiny)
        // FAMILIAS CRT: tipos de entrada en el MISMO ciclo, no señales
        // nuevas. Solo en QA BTC de un feed para no colisionar con el
        // dashboard de 34 instrumentos ni sobrecargar TradingView.
        // El catalogo inspecciona el grafico abierto (own) y su proveedor M5, incluso durante escaneo 34.
        // Mostrarlo no agrega request.security ni permite entradas QA como señales.
        if showEntryCatalog
            table.cell(board,0,5,"MODELO CRT",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,5,chartAvailable ? own.entryFamily : "N/D",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,2,5,chartAvailable ? own.entryStage : "SIN FEED",bgcolor=navy,text_color=chartAvailable and own.entryStage == "M15 CONFIRMADO" ? posInk : color.orange,text_size=size.tiny)
            table.cell(board,3,5,chartAvailable ? (own.direction > 0 ? "COMPRA" : own.direction < 0 ? "VENTA" : "NEUTRO") : "N/D",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,4,5,chartAvailable and not na(own.entryConfirmedAt) ? str.format_time(own.entryConfirmedAt,"HH:mm",TZ) : "M15 ESP",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,5,5,"H4 + M15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,0,6,"OTROS CRT QA",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            // "INSIDE RETURN" puede ser un RATIFIED historico fuera de la
            // ventana de vigencia. Distinguir la memoria de un QA actual.
            string insideShown = chartAvailable ? own.extraFamilyValid and own.extraFamilyKind == "INSIDE QA" ? "INSIDE QA ACT" : own.insideFamilyDiag == "INSIDE RETURN" ? "INSIDE HIST" : own.insideFamilyDiag : "N/D"
            table.cell(board,1,6,insideShown,bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,2,6,chartAvailable ? own.insideStageDiag : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,6,chartAvailable ? own.multiNKind != "MULTI-N ESP" and not na(own.multiNAt) ? own.multiNKind : own.multi4Kind : "MULTI N/D",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,6,chartAvailable and ownFamilyM15QA ? "M15 PROPIO QA" : chartAvailable ? own.retest15State : "RETEST N/D",bgcolor=shade,text_color=chartAvailable and ownFamilyM15QA ? posInk : color.orange,text_size=size.tiny)
            table.cell(board,5,6,"SOLO QA",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        // MSS M5 y M15 son cadenas DISTINTAS. Mostrar espera hasta
        // que se complete una M15 y ROMPA el swing congelado previo C2.
        table.cell(board,0,7,"MSS QA [G]",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,7,chartActive and not na(own.m5At) ? "M5 OK" : "M5 ESP",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,7,m15CRTConfirmed ? "M15 OK" : "M15 ESP",bgcolor=shade,text_color=m15CRTConfirmed ? posInk : color.orange,text_size=size.tiny)
        table.cell(board,3,7,chartAvailable and not na(own.m15Level) ? "PIV:"+str.tostring(own.m15Level, format.mintick) : "PIV:N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,7,chartAvailable and not na(own.qaLastClosedM15At) ? str.format_time(own.qaLastClosedM15At, "dd/MM HH:mm", TZ) : "M15:N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,7,"MISMO FEED",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        // QA CRT: conteo de C1 completas y C2 ratificadas en M5 cargadas.
        // qaLastC2Gate es memoria de la ULTIMA evaluacion, no del CRT
        // corriente: nunca decir "ratificado" sin una fase 2 vigente.
        string crtGateQA = not chartAvailable ? "SIN M5" : ownCRTValid ? "C2 ACTIVA OK" : own.qaLastC2Gate == "CRT C2 RATIFICADO" ? "ULT C2 OK (HIST)" : own.qaLastC2Gate
        table.cell(board,0,8,"HIST QA [G]",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,8,"C1:"+str.tostring(chartAvailable ? own.qaC1Ready : 0),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,2,8,"C2 OK:"+str.tostring(chartAvailable ? own.qaC2Ratified : 0),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,3,8,crtGateQA,bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,8,chartAvailable ? "NY:"+str.tostring(own.qaCurrentH4Hour) : "NY:N/D",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,8,m15CRTConfirmed ? "M15 OK (QA)" : "M15 REQUERIDO",bgcolor=navy,text_color=m15CRTConfirmed ? posInk : color.orange,text_size=size.tiny)
        // Referencia diaria del proveedor confirmada: fechas de la vela 1D.
        table.cell(board,0,9,"D PROVEEDOR",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,9,dChartStart,bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,9,"→",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,9,dChartClose,bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,9,"D CERRADA",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,5,9,chartDayAuditReady ? "M5 OK" : "M5 N/D",bgcolor=navy,text_color=chartDayAuditReady ? posInk : color.gray,text_size=size.tiny)
        table.cell(board,0,10,"PDH 1D OFIC",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,10,chartPrevDAvailable ? str.tostring(chartPrevDHigh,format.mintick) : "N/D",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,2,10,"PDL 1D OFIC",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,10,chartPrevDAvailable ? str.tostring(chartPrevDLow,format.mintick) : "N/D",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,4,10,chartPdhState == "TAKEN" ? "PDH TOM" : chartPdhState == "INTACTO" ? "PDH INT" : "PDH N/D",bgcolor=shade,text_color=f_liqColor(chartPdhState),text_size=size.tiny)
        table.cell(board,5,10,chartPdlState == "TAKEN" ? "PDL TOM" : chartPdlState == "INTACTO" ? "PDL INT" : "PDL N/D",bgcolor=shade,text_color=f_liqColor(chartPdlState),text_size=size.tiny)
        // Fila 11: NY SOLO QA, no usar sus estados para señales 1D.
        // La fila 10 muestra estados PDH/PDL del proveedor.
        // Fila 11: PDH NY - sesion de referencia distinta de la vela D.
        // mostrar niveles exactos del dia NY anterior (no inferir
        // PDH/PDL desde una H4 de exchange con diferente ancla).
        string refNY = chartAvailable and not na(own.nyPDHReferenceAt) ? str.format_time(own.nyPDHReferenceAt, "dd/MM HH:mm", TZ) : "N/D"
        string pdhLevelNY = chartAvailable and not na(own.nyPDH) ? str.tostring(own.nyPDH, format.mintick) : "N/D"
        string pdlLevelNY = chartAvailable and not na(own.nyPDL) ? str.tostring(own.nyPDL, format.mintick) : "N/D"
        table.cell(board,0,11,"NY SOLO QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,11,"PDH:"+pdhLevelNY,bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,2,11,"PDL:"+pdlLevelNY,bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,3,11,refNY,bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,11,chartAvailable ? own.pdhStatus : "N/D",bgcolor=navy,text_color=chartAvailable ? f_liqColor(own.pdhStatus) : color.gray,text_size=size.tiny)
        table.cell(board,5,11,chartAvailable ? own.pdlStatus : "N/D",bgcolor=navy,text_color=chartAvailable ? f_liqColor(own.pdlStatus) : color.gray,text_size=size.tiny)
        // Fila 12: calendario del motor M5, NO la apertura H4 del broker.
        string nyAnchor = chartAvailable and not na(own.nyH4Start) ? str.format_time(own.nyH4Start, "dd/MM HH:mm", TZ) : "N/D"
        bool btcScope = str.upper(syminfo.ticker) == "BTCUSD"
        bool chartIsH4 = timeframe.isintraday and timeframe.multiplier == 240
        bool brokerAligned = chartIsH4 and chartAvailable and not na(own.nyH4Start) and own.nyH4Start == time
        // CRT índices ancla NY 02/06/22, Forex/BTC 01/05/21.
        // Nunca mostrar anclas BTC como si fueran horarios de índices.
        bool indexChartQA = f_index()
        string c1ClocksQA = indexChartQA ? "C1:02/06/22" : "C1:01/05/21"
        string statusNY = not chartAvailable ? "SIN M5" : own.nyH4M5Count > 48 ? (btcScope ? "H4 EXTRA/DST" : "H4 EXTRA") : not chartIsH4 ? "MOTOR M5 NY" : brokerAligned ? "ALINEADA" : "H4 BROKER != NY"
        table.cell(board,0,12,btcScope ? "BTC H4 NY" : "H4 NY QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,12,nyAnchor,bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,12,c1ClocksQA,bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,3,12,"M5:"+str.tostring(chartAvailable ? own.nyH4M5Count : 0),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,12,statusNY,bgcolor=navy,text_color=btcScope and brokerAligned ? posInk : color.orange,text_size=size.tiny)
        table.cell(board,5,12,"America/NY",bgcolor=navy,text_color=color.white,text_size=size.tiny)

        // V34.10r: VISTA QA de AUDITORIA DEL SIMBOLO DEL GRAFICO,
        // NO resultados historicos de los otros 33 feeds ni señales LIVE.
        // Sobrescribe filas 7..11 solo en este modo opt-in. La vista
        // habitual Solo CRT conserva intactos PDH/PDL y MSS.
        if showHistoricAudit
            int a2 = chartAvailable ? own.audit2C : 0
            int a3 = chartAvailable ? own.audit3C : 0
            int ai = chartAvailable ? own.auditInside : 0
            int a4 = chartAvailable ? own.auditM4 : 0
            int an = chartAvailable ? own.auditMN : 0
            table.cell(board,0,7,"HIST M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,7,"2C:"+str.tostring(a2),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,2,7,"3C:"+str.tostring(a3),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,3,7,"INS:"+str.tostring(ai),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,7,"M4:"+str.tostring(a4),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,5,7,"MN:"+str.tostring(an),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,0,8,"C2 RECH",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,8,"GAP:"+str.tostring(chartAvailable ? own.auditC2Data : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,2,8,"DOB:"+str.tostring(chartAvailable ? own.auditC2Double : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,8,"SIN:"+str.tostring(chartAvailable ? own.auditC2NoSweep : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,4,8,"FUERA:"+str.tostring(chartAvailable ? own.auditC2Outside : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,5,8,"HORA:"+str.tostring(chartAvailable ? own.auditC2Hour : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,0,9,"INS RECH",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,9,"GAP:"+str.tostring(chartAvailable ? own.auditInsideData : 0),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,2,9,"DOB:"+str.tostring(chartAvailable ? own.auditInsideDouble : 0),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,9,"OTRO:"+str.tostring(chartAvailable ? own.auditInsideOther : 0),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,4,9,"VENC:"+str.tostring(chartAvailable ? own.auditInsideExpire : 0),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,5,9,"C3 INV:"+str.tostring(chartAvailable ? own.auditC3Invalid : 0),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,0,10,"MN TERM",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,10,"SIN:"+str.tostring(chartAvailable ? own.auditMNNoTerminal : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,2,10,"DOB:"+str.tostring(chartAvailable ? own.auditMNDouble : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,10,"FUERA:"+str.tostring(chartAvailable ? own.auditMNOutside : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,4,10,"H4 GAP:"+str.tostring(chartAvailable ? own.auditH4Incomplete : 0),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,5,10,"SOLO QA",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
            // V34.10t: sumas HISTORICAS sobre las 34 UDT de los 34
            // feeds disponibles, NO setups actuales ni 7 familias LIVE.
            // Cada contador es un evento de MODELO; 2C y 3C pueden
            // referirse al MISMO ciclo. No sumar como operaciones.
            table.cell(board,0,11,scanAll ? "34 HIST QA" : "BTC HIST QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,11,scanAll ? "2C:"+str.tostring(hist2C34) : "SIN 34",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,2,11,scanAll ? "3C:"+str.tostring(hist3C34) : "SOLO 08",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,3,11,scanAll ? "IN:"+str.tostring(histInside34) : "NO 34",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,11,scanAll ? "M4:"+str.tostring(histM434) : "NO FCM",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,5,11,scanAll ? "MN:"+str.tostring(histMN34) : "NO LIVE",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,0,12,"COBERT 34",bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,12,"RESP:"+str.tostring(checked),bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,2,12,"SD:"+str.tostring(missing),bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,3,12,"HIST:"+str.tostring(withHistory34),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,12,"CRT:"+str.tostring(found)+" QA:"+str.tostring(foundQA),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,5,12,"M15QA:"+str.tostring(familyQA15Count),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,0,13,scanAll ? "34 SCAN QA" : "BTC SOLO 1/34",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,13,"CRT:"+str.tostring(found),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,13,"QA:"+str.tostring(foundQA),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,13,"L:PDL",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,4,13,"M5:"+str.tostring(with5),bgcolor=navy,text_color=posInk,text_size=size.tiny)
        table.cell(board,5,13,"M15:"+str.tostring(with15),bgcolor=navy,text_color=posInk,text_size=size.tiny)
        table.cell(board,0,14,"RESP:"+str.tostring(checked)+" SD:"+str.tostring(missing),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,14,"PAG "+str.tostring(page)+"/"+str.tostring(math.max(1,int(math.ceil(passed*1.0/othersOnPage)))),bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,14,"INT=Intacto",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,3,14,"T=Tomado",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,4,14,"PRE/OTR/C2/C3",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,14,"* PROV",bgcolor=navy,text_color=color.gray,text_size=size.tiny)

        // V34.10u: tabla exclusivamente de DIAGNOSTICO, con 10
        // instrumentos por pagina. La vista de trading NO cambia;
        // Solo CRT y Solo CRT + QA siguen mostrando solo patrones.
        // Los 26 feeds sin eventos ya no se confunden con SD:
        // se visualiza 0/C1 o N/D y los gaps se explican aparte.
        if showPerFeedAudit
            table.clear(board,0,0,5,14)
            table.cell(board,0,0,"ACTIVO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,0,"2C/C1",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,2,0,"3C",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,3,0,"INS",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,4,0,"M4",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,5,0,"MN",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            int slotsAudited = scanAll ? 34 : 1
            int auditPages = int(math.ceil(slotsAudited * 1.0 / 10))
            int actualAuditPage = math.min(page, auditPages)
            int auditOffset = (actualAuditPage - 1) * 10
            for k = 0 to 9
                int slot = scanAll ? auditOffset + k : 7
                bool inRange = scanAll ? slot < 34 : k == 0
                if inRange
                    int r = k + 1
                    bool hasFeed = array.get(auditFeedAvailable,slot) == 1
                    int cntC1 = array.get(auditFeedC1,slot)
                    int cnt2 = array.get(auditFeed2C,slot)
                    int cnt3 = array.get(auditFeed3C,slot)
                    int cntInside = array.get(auditFeedInside,slot)
                    int cntM4 = array.get(auditFeedM4,slot)
                    int cntMN = array.get(auditFeedMN,slot)
                    int gaps = array.get(auditFeedH4Gap,slot)
                    int sessionH4 = array.get(auditFeedH4Session,slot)
                    int dstH4 = array.get(auditFeedH4DST,slot)
                    int internalH4 = array.get(auditFeedH4Internal,slot)
                    int rejected = array.get(auditFeedC2Rejected,slot)
                    bool anyHistory = cnt2 + cnt3 + cntInside + cntM4 + cntMN > 0
                    color rowBg = r % 2 == 0 ? navy : shade
                    color ink = not hasFeed ? color.orange : anyHistory ? posInk : color.gray
                    // Marcador del motivo predominante. Nunca llamar
                    // a todas las H4 parciales "GAP del proveedor".
                    // ! discontinuidad M5 interna; ~ sesion/parcial;
                    // D bloque DST completo de 36/60 M5.
                    string marker = internalH4 > 0 ? "!" : dstH4 > 0 ? "D" : sessionH4 > 0 ? "~" : ""
                    string feedName = array.get(scanNames,slot) + (hasFeed and gaps > 0 ? marker : "")
                    table.cell(board,0,r,feedName,bgcolor=rowBg,text_color=hasFeed ? color.white : color.orange,text_size=size.tiny)
                    table.cell(board,1,r,hasFeed ? str.tostring(cnt2)+"/"+str.tostring(cntC1) : "N/D",bgcolor=rowBg,text_color=ink,text_size=size.tiny)
                    table.cell(board,2,r,hasFeed ? str.tostring(cnt3) : "N/D",bgcolor=rowBg,text_color=ink,text_size=size.tiny)
                    table.cell(board,3,r,hasFeed ? str.tostring(cntInside) : "N/D",bgcolor=rowBg,text_color=ink,text_size=size.tiny)
                    table.cell(board,4,r,hasFeed ? str.tostring(cntM4) : "N/D",bgcolor=rowBg,text_color=ink,text_size=size.tiny)
                    table.cell(board,5,r,hasFeed ? str.tostring(cntMN) : "N/D",bgcolor=rowBg,text_color=ink,text_size=size.tiny)
            // Resumen de 34 o del slot BTC de emergencia; nunca ordenes.
            table.cell(board,0,11,"COBERT QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,11,"RESP:"+str.tostring(checked),bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,2,11,"SD:"+str.tostring(missing),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,11,"HIST:"+str.tostring(withHistory34),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,11,"CRT:"+str.tostring(found),bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,5,11,"QA:"+str.tostring(foundQA),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            int pageGaps = 0
            int pageDST = 0
            int pagePartial = 0
            int pageInternal = 0
            int pageRejected = 0
            int pageM15QA = 0
            for j = 0 to 9
                int slot = scanAll ? auditOffset + j : 7
                if scanAll ? slot < 34 : j == 0
                    pageGaps += array.get(auditFeedH4Gap,slot)
                    pageDST += array.get(auditFeedH4DST,slot)
                    pagePartial += array.get(auditFeedH4Session,slot)
                    pageInternal += array.get(auditFeedH4Internal,slot)
                    pageRejected += array.get(auditFeedC2Rejected,slot)
                    pageM15QA += array.get(auditFeedM15QA,slot)
            table.cell(board,0,12,"PAG "+str.tostring(actualAuditPage)+"/"+str.tostring(auditPages),bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,12,"!M5:"+str.tostring(pageInternal),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,2,12,"~PAR:"+str.tostring(pagePartial),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,12,"DST:"+str.tostring(pageDST),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,12,"C2RE:"+str.tostring(pageRejected),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,5,12,"M15QA:"+str.tostring(pageM15QA),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,0,13,"! M5 INTERNO",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,1,13,"~ SES/PARC",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,2,13,"D = DST",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,3,13,"H4:"+str.tostring(pageGaps),bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,4,13,"SOLO QA",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,5,13,"NO FCM",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,0,14,"HIST != CRT ACT",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,1,14,"MAX 1500 M5",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,2,14,"POR FEED",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,3,14,"NO MERGE",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,4,14,"QA",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,5,14,"NO ALERTA",bgcolor=navy,text_color=color.gray,text_size=size.tiny)

        // V34.10w: aislar el 0/0 de 26 feeds sin alterar ninguna señal.
        // Las cifras CAND son horas C1 observadas, y OK C1 solo si
        // la H4 pasó las MISMAS puertas históricas del motor CRT.
        if showC1Audit
            table.clear(board,0,0,5,14)
            table.cell(board,0,0,"ACTIVO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,0,"H4/CAND",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,2,0,"C1 OK",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,3,0,"HORA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,4,0,"DATOS",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,5,0,"RANGO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            int c1AuditedCount = scanAll ? 34 : 1
            int c1Pages = int(math.ceil(c1AuditedCount * 1.0 / 10))
            int c1Page = math.min(page, c1Pages)
            int c1Offset = (c1Page - 1) * 10
            int sumCandidates = 0
            int sumAccepted = 0
            int sumClock = 0
            int sumData = 0
            int sumRange = 0
            for k = 0 to 9
                int slot = scanAll ? c1Offset + k : 7
                bool insidePage = scanAll ? slot < 34 : k == 0
                if insidePage
                    int r = k + 1
                    bool hasFeed = array.get(auditFeedAvailable,slot) == 1
                    int closed = array.get(auditFeedH4Closed,slot)
                    int candidates = array.get(auditFeedC1Hours,slot)
                    int accepted = array.get(auditFeedC1,slot)
                    int badClock = array.get(auditFeedC1Clock,slot)
                    int badData = array.get(auditFeedC1Data,slot)
                    int badRange = array.get(auditFeedC1Range,slot)
                    sumCandidates += candidates
                    sumAccepted += accepted
                    sumClock += badClock
                    sumData += badData
                    sumRange += badRange
                    color bg = r % 2 == 0 ? navy : shade
                    color ink = not hasFeed ? color.orange : accepted > 0 ? posInk : color.gray
                    table.cell(board,0,r,array.get(scanNames,slot),bgcolor=bg,text_color=hasFeed ? color.white : color.orange,text_size=size.tiny)
                    table.cell(board,1,r,hasFeed ? str.tostring(closed)+"/"+str.tostring(candidates) : "N/D",bgcolor=bg,text_color=ink,text_size=size.tiny)
                    table.cell(board,2,r,hasFeed ? str.tostring(accepted) : "N/D",bgcolor=bg,text_color=ink,text_size=size.tiny)
                    table.cell(board,3,r,hasFeed ? str.tostring(badClock) : "N/D",bgcolor=bg,text_color=badClock > 0 ? color.orange : color.gray,text_size=size.tiny)
                    table.cell(board,4,r,hasFeed ? str.tostring(badData) : "N/D",bgcolor=bg,text_color=badData > 0 ? color.orange : color.gray,text_size=size.tiny)
                    table.cell(board,5,r,hasFeed ? str.tostring(badRange) : "N/D",bgcolor=bg,text_color=badRange > 0 ? color.orange : color.gray,text_size=size.tiny)
            table.cell(board,0,11,"C1 QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,11,"CAND:"+str.tostring(sumCandidates),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,2,11,"OK:"+str.tostring(sumAccepted),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,3,11,"HORA:"+str.tostring(sumClock),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,4,11,"DATA:"+str.tostring(sumData),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,5,11,"RAN:"+str.tostring(sumRange),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
            table.cell(board,0,12,"PAG "+str.tostring(c1Page)+"/"+str.tostring(c1Pages),bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,1,12,"RESP:"+str.tostring(checked),bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,2,12,"SD:"+str.tostring(missing),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,3,12,"HIST:"+str.tostring(withHistory34),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
            table.cell(board,4,12,"CRT:"+str.tostring(found),bgcolor=shade,text_color=color.white,text_size=size.tiny)
            table.cell(board,5,12,"QA:"+str.tostring(foundQA),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
            table.cell(board,0,13,"H4 = CERRADAS",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,1,13,"CAND = HORAS",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,2,13,"OK = C1 APTA",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,3,13,"HORA != C2",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,4,13,"DATOS H4",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,5,13,"RANGO H4",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,0,14,"NO SENAL",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,1,14,"HIST M5",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,2,14,"34 FEEDS QA",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,3,14,"NO FCM",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,4,14,"NO LIVE",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
            table.cell(board,5,14,"NO MERGE",bgcolor=navy,text_color=color.gray,text_size=size.tiny)



        // V34.10x: no change to scanner feeds, H4/MSS rules or alerts.
// V34.10z: COMPACTO by default, 34 markets exposed by a verified Pine
// input (Settings > 03/Dashboard). Pine tables have no clickable cells.
// Request loop and engine are unchanged: even compact mode scans 34 M5.
if barstate.islast and showDashboard and compactMobile and not userFocus7
    table.clear(board,0,0,5,14)
    table.cell(board,0,0,"ACTIVO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    bool catalogExpanded = expandFull34 and showCatalog7
    table.cell(board,1,0,catalogExpanded ? "3C/M15" : "CRT H4",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,0,catalogExpanded ? "2C/EXP" : "PDH",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,0,catalogExpanded ? "INS R/C" : "PDL",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,0,catalogExpanded ? "MULTI" : "M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,0,catalogExpanded ? "RETEST" : "M15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    // A complete listed 34 feed is NOT equivalent to 34 active CRTs.
    int feedCount = scanAll ? 34 : 1
    int importantTotal = 0
    int m15ImportantTotal = 0
    for i = 0 to 33
        bool requested = scanAll or i == 7
        bool good = requested and (not qaPhase1NonBtc or i == 7) and array.get(validCoreFlags,i)
        if good
            importantTotal += 1
            if array.get(m15Flags,i) == 1
                m15ImportantTotal += 1
    int itemsPerPage = expandFull34 ? 4 : 2
    int visibleTotal = expandFull34 ? feedCount : importantTotal
    int totalPagesMobile = math.max(1,int(math.ceil(visibleTotal * 1.0 / itemsPerPage)))
    int currentPageMobile = expandFull34 ? math.min(page,totalPagesMobile) : 1
    int displayedMobile = 0
    int eligibleSeenMobile = 0
    // In compact mode: prioritise valid H4 CRT with a confirmed MSS M15,
    // then valid H4 CRT still awaiting MSS M15. Do not include QA signals.
    for priority = 0 to 1
        for i = 0 to 33
            bool requested = scanAll or i == 7
            bool core = (not qaPhase1NonBtc or i == 7) and array.get(validCoreFlags,i)
            bool m15 = core and array.get(m15Flags,i) == 1
            bool rightPriority = expandFull34 ? priority == 0 : priority == 0 ? m15 : core and not m15
            bool eligible = requested and rightPriority and (expandFull34 or core)
            if eligible
                if eligibleSeenMobile >= (currentPageMobile - 1) * itemsPerPage and displayedMobile < itemsPerPage
                    int rr = displayedMobile + 1
                    bool responded = array.get(auditFeedAvailable,i) == 1
                    int phase = array.get(statuses,i)
                    int direction = array.get(directions,i)
                    bool extraQA = array.get(validCrtFlags,i) and not core
                    string family = array.get(familyLabels,i)
                    string stateText = not responded ? "SIN FEED" : core ? direction == 1 ? "ALC" : "BAJ" : extraQA ? family == "INSIDE QA" ? "INS QA" : family == "MULTI-N QA" ? "MN QA" : "M4 QA" : phase == 1 ? "C2*" : array.get(auditFeedH4Closed,i) <= 0 ? "H4 N/D" : "ESPERA"
                    color stateTint = core ? direction == 1 ? posInk : negInk : extraQA or phase == 1 ? color.orange : color.gray
                    color bg = rr % 2 == 0 ? shade : navy
                    bool m5 = core and array.get(m5Flags,i) == 1
                    bool m15QA = extraQA and array.get(extraM15Flags,i) == 1
                    table.cell(board,0,rr,array.get(scanNames,i),bgcolor=bg,text_color=responded ? color.white : color.orange,text_size=size.tiny)
                    int categoryMask = array.get(qaCatalogPerFeed,i)
                    bool cat3C = int(math.floor(categoryMask / 1)) % 2 == 1
                    bool cat2C = int(math.floor(categoryMask / 2)) % 2 == 1
                    bool catExpansion = int(math.floor(categoryMask / 4)) % 2 == 1
                    bool catInsideR = int(math.floor(categoryMask / 8)) % 2 == 1
                    bool catInsideC = int(math.floor(categoryMask / 16)) % 2 == 1
                    bool catMulti = int(math.floor(categoryMask / 32)) % 2 == 1
                    bool catRetest = int(math.floor(categoryMask / 64)) % 2 == 1
                    // Non-operational catalogue states must never inherit
                    // another family MSS or an unrelated live CRT status.
                    // Never render the unverified +1 minute M15 as a green check.
                    // Neither historical labels nor a 3C bit prove Pine/feed parity.
                    bool catM15Observed = false // true C3 C1 sweep QA has no borrowed 2C M15
                    string cat3Label = not responded ? "SIN FEED" : cat3C ? "3C TRUE QA" : "—"
                    string cat2Label = cat2C ? "2C*" : catExpansion ? "EXP RECH" : "—"
                    string catInsideLabel = catInsideR ? "RET QA" : catInsideC ? "CONT RECH" : "—"
                    table.cell(board,1,rr,catalogExpanded ? cat3Label : stateText,bgcolor=bg,text_color=catalogExpanded ? cat3C ? color.orange : color.gray : stateTint,text_size=size.tiny)
                    table.cell(board,2,rr,catalogExpanded ? cat2Label : responded ? array.get(pdhTexts,i) : "N/D",bgcolor=bg,text_color=catalogExpanded ? color.orange : color.gray,text_size=size.tiny)
                    table.cell(board,3,rr,catalogExpanded ? catInsideLabel : responded ? array.get(pdlTexts,i) : "N/D",bgcolor=bg,text_color=catalogExpanded ? color.orange : color.gray,text_size=size.tiny)
                    table.cell(board,4,rr,catalogExpanded ? catMulti ? "MULTI QA" : "—" : m5 ? "✓" : "—",bgcolor=bg,text_color=catalogExpanded ? color.orange : m5 ? posInk : color.gray,text_size=size.tiny)
                    table.cell(board,5,rr,catalogExpanded ? catRetest ? "RT M15 QA" : "—" : m15 ? "✓" : m15QA ? "QA" : "—",bgcolor=bg,text_color=catalogExpanded ? color.orange : m15 ? posInk : m15QA ? color.orange : color.gray,text_size=size.tiny)
                    displayedMobile += 1
                eligibleSeenMobile += 1
    if not expandFull34 and importantTotal == 0
        table.cell(board,0,1,"SIN CRT VIGENTE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,1,1,"EN ESPERA",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    // Footer row 5 is reserved for full-list mode; compact needs row 3/4 only.
    int footerRow = expandFull34 ? 5 : 3
    table.cell(board,0,footerRow,expandFull34 ? "P "+str.tostring(currentPageMobile)+"/"+str.tostring(totalPagesMobile) : "CRT:"+str.tostring(importantTotal),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,footerRow,expandFull34 ? "34 QA" : "M15:"+str.tostring(m15ImportantTotal),bgcolor=shade,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,footerRow,"R:"+str.tostring(checked)+"/"+str.tostring(feedCount),bgcolor=shade,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,footerRow,"SIN:"+str.tostring(missing),bgcolor=shade,text_color=missing > 0 ? color.orange : color.gray,text_size=size.tiny)
    table.cell(board,4,footerRow,"QA:"+str.tostring(foundQA),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,5,footerRow,"NO PUSH",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    int hintRow = expandFull34 ? 6 : 4
    table.cell(board,0,hintRow,expandFull34 ? "PAG: AJUSTES" : "VER 34",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,hintRow,expandFull34 ? showCatalog7 ? "7 CAT QA" : "03/PAG" : "AJUSTES",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,2,hintRow,scanAll ? "34 FEEDS" : "BTC SOLO",bgcolor=navy,text_color=scanAll ? color.aqua : color.orange,text_size=size.tiny)
    table.cell(board,3,hintRow,"HIST:"+str.tostring(withHistory34),bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    table.cell(board,4,hintRow,qaPhase1NonBtc ? "QA FASE" : visualChartAligned ? "TF OK" : "TF !NY",bgcolor=navy,text_color=qaPhase1NonBtc ? color.orange : visualChartAligned ? posInk : color.orange,text_size=size.tiny)
    table.cell(board,5,hintRow,expandFull34 ? "CERRAR AJ" : "SOLO CRT",bgcolor=navy,text_color=color.gray,text_size=size.tiny)

// V34.11M: cosmetic, opt-in UTC evidence presentation. Raw UTCmin remains accessible.
// V34.11b: read-only event snapshot of ONE requested scanner slot.
// 60 existing plot() calls are unchanged; the 6x15 table is REUSED.
// TradingView must compile this candidate before any QA certification.
f_qaUtcMin(int t) =>
    na(t) or t <= 0 ? "N/D" : qaReadableUtc ? str.format_time(t, "dd/MM HH:mm", "Etc/UTC") : str.tostring(math.round(t / 60000))
f_qaPrice(float p) =>
    na(p) ? "N/D" : str.tostring(p, "#.##########")

if barstate.islast and showDashboard and showSlotEventAudit
    table.clear(board,0,0,5,14)
    int chartExactSlot = -1
    for scanI = 0 to 33
        if ticker.standard(array.get(scanSymbols,scanI)) == ownStd
            chartExactSlot := scanI
            break
    int slot = qaFollowChart and chartExactSlot >= 0 ? chartExactSlot : qaEventSlot - 1
    string selectedFeed = array.get(scanSymbols,slot)
    bool sameProviderFeed = ticker.standard(selectedFeed) == ownStd
    bool requested = scanAll or slot == 7
    bool responded = requested and array.get(auditFeedAvailable,slot) == 1
    int mask = array.get(qaCatalogPerFeed,slot)
    // This is a CURRENT signal snapshot; 0 means no CURRENT model.
    // Lines named only "CRH"/"CRL" are NOT produced by V34.11b/c.
    string displayedPhase = not responded ? "SIN FEED" : array.get(statuses,slot) == 0 ? "SIN CRT ACT" : "PH "+str.tostring(array.get(statuses,slot))
    color bg = shade
    table.cell(board,0,0,"QA "+str.tostring(slot+1)+"/34",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,0,"PHASE",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,0,"MASK 7",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,0,"C1 UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,0,"C2 UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,0,"RAT UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,1,array.get(scanNames,slot),bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,1,displayedPhase,bgcolor=bg,text_color=responded ? color.aqua : color.orange,text_size=size.tiny)
    table.cell(board,2,1,responded ? str.tostring(mask) : "N/D",bgcolor=bg,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,3,1,responded ? f_qaUtcMin(array.get(qaC1BySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,1,responded ? f_qaUtcMin(array.get(qaC2BySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,1,responded ? f_qaUtcMin(array.get(qaRatBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,2,"SWEEP UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,2,"PIV15 UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,2,"MSS15 UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,2,"M15 CERR",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,2,"PIVOT15 PX",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,2,"FUENTE",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,3,responded ? f_qaUtcMin(array.get(qaSweepBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,3,responded ? f_qaUtcMin(array.get(qaPivot15AtBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,3,responded ? f_qaUtcMin(array.get(qaBreak15BySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,3,responded ? f_qaUtcMin(array.get(qaClosed15BySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,3,responded ? f_qaPrice(array.get(qaPivot15PriceBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,3,not requested ? "NO SCAN" : sameProviderFeed ? "FEED=CHART" : "FEED!=CHART",bgcolor=bg,text_color=not requested or not sameProviderFeed ? color.orange : color.aqua,text_size=size.tiny)
    table.cell(board,0,4,"EXTRA QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,4,"X-C1 UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,4,"X-SWEEP",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,4,"X-PIV15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,4,"X-MSS15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,4,"X-RAT",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,5,responded ? array.get(qaExtraKindBySlot,slot) : "N/D",bgcolor=bg,text_color=color.orange,text_size=size.tiny)
    table.cell(board,1,5,responded ? f_qaUtcMin(array.get(qaExtraC1BySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,5,responded ? f_qaUtcMin(array.get(qaExtraSweepBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,5,responded ? f_qaUtcMin(array.get(qaExtraPivot15AtBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,5,responded ? f_qaUtcMin(array.get(qaExtraBreak15BySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,5,responded ? f_qaUtcMin(array.get(qaExtraRatBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,6,"EXTRA PIV PX",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,6,"R:"+str.tostring(checked)+"/"+str.tostring(scanAll ? 34 : 1),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,6,"MASK=EST",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    table.cell(board,3,6,"EST ACTUAL",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    table.cell(board,4,6,"NO LIVE",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    table.cell(board,5,6,"NO PUSH",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    table.cell(board,0,7,responded ? f_qaPrice(array.get(qaExtraPivot15PriceBySlot,slot)) : "N/D",bgcolor=bg,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,8,"GRAFICO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,8,syminfo.tickerid,bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,2,8,"FEED "+str.tostring(slot+1),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,8,selectedFeed,bgcolor=navy,text_color=sameProviderFeed ? color.aqua : color.orange,text_size=size.tiny)
    table.cell(board,4,8,sameProviderFeed ? "MISMO ORIGEN" : "PROV DIF",bgcolor=navy,text_color=sameProviderFeed ? color.aqua : color.orange,text_size=size.tiny)
    table.cell(board,5,8,qaFollowChart ? chartExactSlot >= 0 ? "AUTO" : "SIN MATCH" : "MANUAL",bgcolor=navy,text_color=chartExactSlot >= 0 ? color.aqua : color.orange,text_size=size.tiny)
    table.cell(board,0,9,"V34.11R",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,9,"R=RESP",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,2,9,"NO=OHLC QA",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,3,9,"EST=ACTUAL",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,4,9,showLevels and visible ? "LINEAS NY SI" : "LINEAS NY NO",bgcolor=shade,text_color=showLevels and visible ? color.aqua : color.orange,text_size=size.tiny)
    table.cell(board,5,9,"NO LIVE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    if qaHistoricLast
        // LAST OBSERVED eventAt only; never infer C1/sweep/MSS15 from these timestamps.
        table.cell(board,0,10,"ULT C2 PEND",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,10,"ULT C2 RAT",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,10,"EXP RECH",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,10,"ULT 3C",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,10,"INS RET",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,10,"INS CONT",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,0,11,responded ? f_qaUtcMin(array.get(qaHistCandidate2CBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,1,11,responded ? f_qaUtcMin(array.get(qaHistRatified2CBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,2,11,responded ? f_qaUtcMin(array.get(qaHistRejectedExpansionBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,11,responded ? f_qaUtcMin(array.get(qaHistConfirmed3CBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,4,11,responded ? f_qaUtcMin(array.get(qaHistInsideReturnBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,5,11,responded ? f_qaUtcMin(array.get(qaHistInsideContinuationBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,0,12,"ULT MULTI4",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,12,"ULT MULTIN",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,12,"ULT RETEST",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,12,"HIST != ACT",bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,4,12,"SIN MSS PROOF",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,12,"QA ONLY",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,0,13,responded ? f_qaUtcMin(array.get(qaHistMulti4BySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,1,13,responded ? f_qaUtcMin(array.get(qaHistMultiNBySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,2,13,responded ? f_qaUtcMin(array.get(qaHistRetest15BySlot,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,13,responded ? "CERRADAS" : "SIN FEED",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,4,13,qaReadableUtc ? "DD/MM UTC" : "UTCmin",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,13,"SIN CERT",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,0,14,"ULTIMOS",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,1,14,"1500 M5",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,2,14,"MISMO FEED",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,3,14,"NO LIVE",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,4,14,"NO FCM",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,14,"NO PUSH",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    else
        // Historical counters are computed by the SAME 1500 M5 scanner feed.
        // They are NOT current setups, seven independent entry approvals,
        // or full provider history. Missing snapshots are printed N/D.
        table.cell(board,0,10,"HIST 1500 M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,10,"C1 NY",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,10,"2C QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,10,"3C QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,10,"INS QA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,10,"M4 / MN",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,0,11,responded ? str.tostring(array.get(auditFeedH4Closed,slot))+" H4" : "SIN FEED",bgcolor=shade,text_color=responded ? color.aqua : color.orange,text_size=size.tiny)
        table.cell(board,1,11,responded ? str.tostring(array.get(auditFeedC1,slot)) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,11,responded ? str.tostring(array.get(auditFeed2C,slot)) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,11,responded ? str.tostring(array.get(auditFeed3C,slot)) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,11,responded ? str.tostring(array.get(auditFeedInside,slot)) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,11,responded ? str.tostring(array.get(auditFeedM4,slot))+"/"+str.tostring(array.get(auditFeedMN,slot)) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
        table.cell(board,0,12,"H4 BAD",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,12,"H4 PARC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,2,12,"H4 INT",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,3,12,"C1 HORA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,4,12,"C1 DATO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,5,12,"C1 CLK",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,0,13,responded ? str.tostring(array.get(auditFeedH4Gap,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,1,13,responded ? str.tostring(array.get(auditFeedH4Session,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,2,13,responded ? str.tostring(array.get(auditFeedH4Internal,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,13,responded ? str.tostring(array.get(auditFeedC1Hours,slot)) : "N/D",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,4,13,responded ? str.tostring(array.get(auditFeedC1Data,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,5,13,responded ? str.tostring(array.get(auditFeedC1Clock,slot)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,0,14,"DST / C2 RECH",bgcolor=navy,text_color=color.white,text_size=size.tiny)
        table.cell(board,1,14,responded ? str.tostring(array.get(auditFeedH4DST,slot)) : "N/D",bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,2,14,responded ? str.tostring(array.get(auditFeedC2Rejected,slot)) : "N/D",bgcolor=navy,text_color=color.orange,text_size=size.tiny)
        table.cell(board,3,14,responded ? "NY 01/05/21" : "SIN FEED",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
        table.cell(board,4,14,"M5 CERR",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
        table.cell(board,5,14,"NO PUSH",bgcolor=navy,text_color=color.gray,text_size=size.tiny)


// V34.11f: group-wide QA for all 33 markets EXCLUDING BTC slot 8.
// Reuses only data already fetched in the original 34 M5 requests.
// Under no circumstances interpret responses or zero-gap counts as
// seven certified CRT family entries. The dashboard remains compact
// unless the user explicitly enables this screen.
if barstate.islast and showDashboard and showNonBtcCohortQA
    table.clear(board,0,0,5,14)
    int nonBtcRequested = scanAll ? 33 : 0
    int nonBtcResponded = 0
    int nonBtcHistory = 0
    int nonBtcZeroC1 = 0
    int nonBtcWithC1 = 0
    int nonBtcBlockedH4 = 0
    int nonBtcWithCrtHistory = 0
    int nonBtcInternalGaps = 0
    int nonBtcPartialGaps = 0
    int fxAsked = 0
    int metalAsked = 0
    int indexAsked = 0
    // Index slot conventions are from the 34-slot default catalogue.
    // If a source is manually changed, its provider/ticker still shows
    // in the row; family label describes catalogue slot, not provider QA.
    for i = 0 to 33
        if i != 7 and scanAll
            bool availableNonBtc = array.get(auditFeedAvailable,i) == 1
            bool metalSlot = i == 3 or i == 16
            bool indexSlot = i == 4 or i == 5 or i == 6
            if indexSlot
                indexAsked += 1
            else if metalSlot
                metalAsked += 1
            else
                fxAsked += 1
            if availableNonBtc
                nonBtcResponded += 1
                int h4Observed = array.get(auditFeedH4Closed,i)
                int h4Bad = array.get(auditFeedH4Gap,i)
                int c1Ok = array.get(auditFeedC1,i)
                nonBtcHistory += h4Observed
                nonBtcInternalGaps += array.get(auditFeedH4Internal,i)
                nonBtcPartialGaps += array.get(auditFeedH4Session,i)
                if c1Ok > 0
                    nonBtcWithC1 += 1
                else
                    nonBtcZeroC1 += 1
                if h4Observed > 0 and h4Bad >= h4Observed
                    nonBtcBlockedH4 += 1
                if array.get(auditFeed2C,i) > 0 or array.get(auditFeed3C,i) > 0 or array.get(auditFeedInside,i) > 0 or array.get(auditFeedM4,i) > 0 or array.get(auditFeedMN,i) > 0
                    nonBtcWithCrtHistory += 1

    // Four individually identified 33-market results per page, 9 pages.
    int lastPage33 = math.max(1,int(math.ceil(nonBtcRequested * 1.0 / 4)))
    int visiblePage33 = math.min(page,lastPage33)
    table.cell(board,0,0,qaPhase1NonBtc ? "QA FASE" : "QA NY:00",bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,0,"TIPO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,0,qa33RootView ? "MAL INI" : "H4 CERR",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,0,qa33RootView ? "MAL FIN" : "H4 BAD",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,0,qa33RootView ? "NO 48" : "C1 OK",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,0,"ESTADO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    int ordinal33 = 0
    int printed33 = 0
    for i = 0 to 33
        if i != 7 and scanAll
            if ordinal33 >= (visiblePage33 - 1) * 4 and printed33 < 4
                int rr = printed33 + 1
                bool responded33 = array.get(auditFeedAvailable,i) == 1
                int h4Count33 = array.get(auditFeedH4Closed,i)
                int badH433 = array.get(auditFeedH4Gap,i)
                int c1Count33 = array.get(auditFeedC1,i)
                bool index33 = i == 4 or i == 5 or i == 6
                bool metal33 = i == 3 or i == 16
                string cls33 = index33 ? "IND" : metal33 ? "MET" : "FX"
                string status33 = not responded33 ? "SIN FEED" : h4Count33 <= 0 ? "SIN H4" : badH433 >= h4Count33 ? "H4 BLOQ" : c1Count33 <= 0 ? "SIN C1" : array.get(auditFeed3C,i) > 0 ? "3C HIST" : array.get(auditFeed2C,i) > 0 ? "2C HIST" : "C1 LISTA"
                color rowBg33 = rr % 2 == 0 ? shade : navy
                table.cell(board,0,rr,array.get(scanNames,i),bgcolor=rowBg33,text_color=color.white,text_size=size.tiny)
                int phase33 = array.get(auditFeedPhaseMin,i)
                string clsWithPhase = cls33 + (not na(phase33) ? "+"+str.tostring(phase33) : "?")
                table.cell(board,1,rr,clsWithPhase,bgcolor=rowBg33,text_color=qaPhase1NonBtc ? color.orange : color.gray,text_size=size.tiny)
                int badStart33 = array.get(auditFeedH4StartMis,i)
                int badEnd33 = array.get(auditFeedH4EndMis,i)
                int badBars33 = array.get(auditFeedH4BarsMis,i)
                table.cell(board,2,rr,responded33 ? str.tostring(qa33RootView ? badStart33 : h4Count33) : "N/D",bgcolor=rowBg33,text_color=qa33RootView and badStart33 > 0 ? color.orange : color.white,text_size=size.tiny)
                table.cell(board,3,rr,responded33 ? str.tostring(qa33RootView ? badEnd33 : badH433) : "N/D",bgcolor=rowBg33,text_color=qa33RootView and badEnd33 > 0 or not qa33RootView and badH433 > 0 ? color.orange : color.gray,text_size=size.tiny)
                table.cell(board,4,rr,responded33 ? str.tostring(qa33RootView ? badBars33 : c1Count33) : "N/D",bgcolor=rowBg33,text_color=qa33RootView and badBars33 > 0 ? color.orange : not qa33RootView and c1Count33 > 0 ? color.aqua : color.gray,text_size=size.tiny)
                table.cell(board,5,rr,status33,bgcolor=rowBg33,text_color=not responded33 or badH433 >= h4Count33 ? color.orange : color.white,text_size=size.tiny)
                printed33 += 1
            ordinal33 += 1
    if not scanAll
        table.cell(board,0,1,"ACTIVA 34",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
        table.cell(board,1,1,"00/MEM",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,0,5,"P "+str.tostring(visiblePage33)+"/"+str.tostring(lastPage33),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,5,"R:"+str.tostring(nonBtcResponded)+"/"+str.tostring(nonBtcRequested),bgcolor=shade,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,5,"0C1:"+str.tostring(nonBtcZeroC1),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,3,5,"C1+:"+str.tostring(nonBtcWithC1),bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,4,5,"BLOQ:"+str.tostring(nonBtcBlockedH4),bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,5,5,"HIST:"+str.tostring(nonBtcWithCrtHistory),bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,0,6,"FX:"+str.tostring(fxAsked),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,6,"MET:"+str.tostring(metalAsked),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,6,"IND:"+str.tostring(indexAsked),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,6,"H4:"+str.tostring(nonBtcHistory),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,6,"PARC:"+str.tostring(nonBtcPartialGaps),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
    table.cell(board,5,6,"INT:"+str.tostring(nonBtcInternalGaps),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
    table.cell(board,0,7,qa33RootView ? "MAL=NO SUM" : "BTC APARTE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,1,7,scanAll and array.get(auditFeedAvailable,7) == 1 ? "BTC RESP" : "BTC N/D",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,2,7,"C1 BTC:",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,3,7,scanAll and array.get(auditFeedAvailable,7) == 1 ? str.tostring(array.get(auditFeedC1,7)) : "N/D",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,4,7,qaPhase1NonBtc ? "QA FASE" : "NY :00",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,5,7,"NO PUSH",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    // Automatically inspect the chart's exact source if it exists in the 33.
    // BTC slot 8 is never mixed into this diagnostic.
    int chartSlot33 = -1
    for i = 0 to 33
        if i != 7 and ticker.standard(array.get(scanSymbols,i)) == ownStd
            chartSlot33 := i
            break
    int traceSlot33 = chartSlot33 >= 0 ? chartSlot33 : qaEventSlot-1
    bool traceAllowed33 = traceSlot33 != 7 and scanAll and array.get(auditFeedAvailable,traceSlot33) == 1
    table.cell(board,0,8,"H4 ULT M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,8,"# M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,8,"INICIO Δm",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,8,"FIN Δm",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,8,"FEED",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,8,"MODO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,9,traceAllowed33 ? array.get(scanNames,traceSlot33) : "SIN QA",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,9,traceAllowed33 and not na(array.get(auditFeedH4LastBars,traceSlot33)) ? str.tostring(array.get(auditFeedH4LastBars,traceSlot33)) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,9,traceAllowed33 and not na(array.get(auditFeedH4StartShift,traceSlot33)) ? str.tostring(array.get(auditFeedH4StartShift,traceSlot33)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,3,9,traceAllowed33 and not na(array.get(auditFeedH4EndShift,traceSlot33)) ? str.tostring(array.get(auditFeedH4EndShift,traceSlot33)) : "N/D",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,4,9,traceAllowed33 ? array.get(scanSymbols,traceSlot33) : "N/D",bgcolor=shade,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,9,traceAllowed33 ? qaPhase1NonBtc ? "QA FASE" : "NY:00" : "BTC APARTE",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    // Deep inspect an individual slot using the existing per-slot QA table:
    // no data is sampled from the visible chart's timeframe.
    // Offsets below capture the LAST closed H4 of the same M5 source.
    // A value of 0 is aligned; nonzero identifies which boundary differs. 



// V34.11O: focus only on CRT H4 + independent MSS5/MSS15. C3 is IN PROGRESS until its H4 closes.
// Legacy candidate/rejection/retest diagnostic is opt-in in 34 expanded mode.
// V34.11Q: bit 1 now reflects real independent 3C geometry. Its MSS is not guessed.
// V34.11N OWNER MODE — seven *catalog roles*, not seven actionable patterns.
// One status line per independent feed. Only same-cycle core CRT can print a
// positive MSS5/MSS15 confirmation. Inside and Multi remain QA, while
// provisional/rejected/retest contexts are NEVER promoted to a valid CRT.
// Debug single-slot and 33-source QA views keep visual priority.
if barstate.islast and showDashboard and compactMobile and userFocus7 and not showSlotEventAudit and not showNonBtcCohortQA
    table.clear(board,0,0,5,14)
    table.cell(board,0,0,"MERCADO",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,0,"CRT H4",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,0,"DIR",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,3,0,"MSS M5",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,0,"MSS M15",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,5,0,"ETAPA",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    int nFeeds = scanAll ? 34 : 1
    int currentStruct = 0
    int m15SameCycle = 0
    int qaStructCount = 0
    for i = 0 to 33
        if scanAll or i == 7
            bool core = array.get(validCoreFlags,i)
            bool qaCore = array.get(qaCoreObservedFlags,i)
            bool extra = array.get(validCrtFlags,i) and not core and not qaCore
            int viewMask = array.get(qaCatalogPerFeed,i)
            bool structuralObservedQA = not core and not qaCore and not extra and (int(math.floor(viewMask / 1)) % 2 == 1 or int(math.floor(viewMask / 8)) % 2 == 1 or int(math.floor(viewMask / 32)) % 2 == 1)
            int sweepT = array.get(qaSweepBySlot,i)
            int c1T = array.get(qaC1BySlot,i)
            int ratT = array.get(qaRatBySlot,i)
            int pivot5T = array.get(m5PivotTimes,i)
            int break5T = array.get(m5Times,i)
            int pivot15T = array.get(qaPivot15AtBySlot,i)
            int break15T = array.get(m15Times,i)
            int close15T = array.get(qaClosed15BySlot,i)
            int nativePhase = array.get(qaSourcePhaseBySlot,i)
            bool cycleRoot = (core or qaCore) and not na(c1T) and not na(sweepT) and sweepT > c1T and not na(ratT) and ratT >= sweepT
            bool sameM5 = cycleRoot and not na(pivot5T) and pivot5T < sweepT and break5T > sweepT and (not na(nativePhase) and nativePhase >= 0 and nativePhase <= 4 and break5T % MIN5 == nativePhase * 60000)
            bool sameM15 = cycleRoot and not na(pivot15T) and pivot15T < sweepT and break15T > sweepT and not na(close15T) and break15T <= close15T and f_m15_phase_ok(break15T, nativePhase)
            if core
                currentStruct += 1
                if sameM15
                    m15SameCycle += 1
            else if qaCore or extra or structuralObservedQA
                qaStructCount += 1
    int onPage = expandFull34 ? 10 : 2
    int visibleCount = expandFull34 ? nFeeds : currentStruct + qaStructCount
    int totalPages = math.max(1,int(math.ceil(visibleCount * 1.0 / onPage)))
    int pageNow = expandFull34 ? math.min(page,totalPages) : 1
    int visited = 0
    int drawn = 0
    // Observed-but-unapproved 3C/Inside/Multi roles from 33 non-BTC remain orange QA.
    // For a non-BTC 2C H4 closed in native-source phase, expose QA-only
    // M5 and M15 proofs; they remain orange until external parity is certified.
    // Only active structural statuses are promoted into compact monitoring.
    // A QA structural family is orange even if it has an independent M15 QA.
    // For expanded 34 view, all seven catalog states remain inspectable.
    for priority = 0 to 2
        for i = 0 to 33
            bool requested = scanAll or i == 7
            bool core = array.get(validCoreFlags,i)
            bool qaCore = array.get(qaCoreObservedFlags,i)
            bool extra = array.get(validCrtFlags,i) and not core and not qaCore
            int viewMask = array.get(qaCatalogPerFeed,i)
            bool structuralObservedQA = not core and not qaCore and not extra and (int(math.floor(viewMask / 1)) % 2 == 1 or int(math.floor(viewMask / 8)) % 2 == 1 or int(math.floor(viewMask / 32)) % 2 == 1)
            int sweepT = array.get(qaSweepBySlot,i)
            int c1T = array.get(qaC1BySlot,i)
            int ratT = array.get(qaRatBySlot,i)
            int pivot5T = array.get(m5PivotTimes,i)
            int break5T = array.get(m5Times,i)
            int pivot15T = array.get(qaPivot15AtBySlot,i)
            int break15T = array.get(m15Times,i)
            int close15T = array.get(qaClosed15BySlot,i)
            int nativePhase = array.get(qaSourcePhaseBySlot,i)
            bool cycleRoot = (core or qaCore) and not na(c1T) and not na(sweepT) and sweepT > c1T and not na(ratT) and ratT >= sweepT
            bool sameM5 = cycleRoot and not na(pivot5T) and pivot5T < sweepT and break5T > sweepT and (not na(nativePhase) and nativePhase >= 0 and nativePhase <= 4 and break5T % MIN5 == nativePhase * 60000)
            bool sameM15 = cycleRoot and not na(pivot15T) and pivot15T < sweepT and break15T > sweepT and not na(close15T) and break15T <= close15T and f_m15_phase_ok(break15T, nativePhase)
            bool selectedPriority = expandFull34 ? priority == 0 : priority == 0 ? core and sameM15 : priority == 1 ? core and not sameM15 : qaCore or extra or structuralObservedQA
            bool visibleRow = requested and selectedPriority
            if visibleRow
                if visited >= (pageNow-1)*onPage and drawn < onPage
                    int rowIndex = drawn + 1
                    int mask = array.get(qaCatalogPerFeed,i)
                    bool cat3 = int(math.floor(mask / 1)) % 2 == 1
                    bool cat2 = int(math.floor(mask / 2)) % 2 == 1
                    bool catExpansion = int(math.floor(mask / 4)) % 2 == 1
                    bool catInsideReturn = int(math.floor(mask / 8)) % 2 == 1
                    bool catInsideContinuation = int(math.floor(mask / 16)) % 2 == 1
                    bool catMulti = int(math.floor(mask / 32)) % 2 == 1
                    bool catRetest = int(math.floor(mask / 64)) % 2 == 1
                    bool feedOK = array.get(auditFeedAvailable,i) == 1
                    int signedTrue3C = array.get(qaTrue3CSignedBySlot,i)
                    bool ownTrue3C = cat3 and not core and not qaCore and not na(signedTrue3C)
                    int dir = ownTrue3C ? signedTrue3C > 0 ? 1 : -1 : core or extra ? array.get(directions,i) : qaCore or structuralObservedQA ? array.get(qaObservedDirectionBySlot,i) : 0
                    bool showRejectedDiagnostics = expandFull34 and showCatalog7
                    string role = not feedOK ? "SIN FEED" : core ? "2C RAT" : qaCore ? "2C QA" : ownTrue3C ? "3C TRUE QA" : extra ? array.get(familyLabels,i) : catInsideReturn ? "INS RET QA" : catMulti ? "MULTI QA" : showRejectedDiagnostics ? cat2 ? "2C*" : catExpansion ? "EXP RECH" : catInsideContinuation ? "INS RECH" : catRetest ? "RETEST QA" : "—" : "—"
                    string stage = not feedOK ? "SIN FEED" : core ? "C3 ACT" : qaCore ? "C3 QA" : ownTrue3C ? "C3 CERR QA" : extra or structuralObservedQA ? "QA H4" : showRejectedDiagnostics ? catExpansion or catInsideContinuation ? "RECHAZO" : cat2 ? "PENDIENTE" : catRetest ? "QA MSS" : mask != 0 ? "QA" : "ESPERA" : "ESPERA"
                    string m5Text = core ? sameM5 ? "SI" : "NO" : qaCore ? sameM5 ? "QA SI" : "QA --" : ownTrue3C ? "N/V" : extra or structuralObservedQA ? "N/V" : "—"
                    string m15Text = core ? sameM15 ? "SI" : "NO" : qaCore ? sameM15 ? "QA SI" : "QA --" : ownTrue3C ? "N/V" : extra and array.get(extraM15Flags,i) == 1 ? "QA" : extra or structuralObservedQA ? "N/V" : "—"
                    string dirText = core or qaCore or ownTrue3C or extra or structuralObservedQA ? dir > 0 ? "ALC" : dir < 0 ? "BAJ" : "?" : "—"
                    color bg = rowIndex % 2 == 0 ? shade : navy
                    color textState = core ? posInk : qaCore or extra or structuralObservedQA or mask != 0 ? color.orange : color.gray
                    table.cell(board,0,rowIndex,array.get(scanNames,i),bgcolor=bg,text_color=feedOK ? color.white : color.orange,text_size=size.tiny)
                    table.cell(board,1,rowIndex,role,bgcolor=bg,text_color=textState,text_size=size.tiny)
                    table.cell(board,2,rowIndex,dirText,bgcolor=bg,text_color=dir < 0 ? negInk : dir > 0 ? posInk : color.gray,text_size=size.tiny)
                    table.cell(board,3,rowIndex,m5Text,bgcolor=bg,text_color=core and sameM5 ? posInk : qaCore and sameM5 ? color.orange : color.gray,text_size=size.tiny)
                    table.cell(board,4,rowIndex,m15Text,bgcolor=bg,text_color=core and sameM15 ? posInk : qaCore or extra ? color.orange : color.gray,text_size=size.tiny)
                    table.cell(board,5,rowIndex,stage,bgcolor=bg,text_color=textState,text_size=size.tiny)
                    drawn += 1
                visited += 1
    if not expandFull34 and visibleCount == 0
        table.cell(board,0,1,"SIN CRT ACTUAL",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
        table.cell(board,1,1,"34 VIGILADOS",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    int summaryRow = expandFull34 ? 11 : 3
    table.cell(board,0,summaryRow,expandFull34 ? "P "+str.tostring(pageNow)+"/"+str.tostring(totalPages) : "CRT:"+str.tostring(currentStruct),bgcolor=navy,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,1,summaryRow,"M15:"+str.tostring(m15SameCycle),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,2,summaryRow,"QA:"+str.tostring(qaStructCount),bgcolor=navy,text_color=color.orange,text_size=size.tiny)
    table.cell(board,3,summaryRow,"R:"+str.tostring(checked)+"/"+str.tostring(nFeeds),bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,4,summaryRow,expandFull34 and showCatalog7 ? "7 ROLES QA" : "CRT/MSS",bgcolor=navy,text_color=color.orange,text_size=size.tiny)
    table.cell(board,5,summaryRow,"NO PUSH",bgcolor=navy,text_color=color.gray,text_size=size.tiny)
    int infoRow = expandFull34 ? 12 : 4
    table.cell(board,0,infoRow,"N/V = NO VERIF.",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,1,infoRow,"QA NO CERT",bgcolor=shade,text_color=color.orange,text_size=size.tiny)
    table.cell(board,2,infoRow,expandFull34 and showCatalog7 ? "2C* = PEND" : "C3 ACT != CERR",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,3,infoRow,expandFull34 and showCatalog7 ? "RECH != CRT" : "7 CAT EN QA",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
    table.cell(board,4,infoRow,expandFull34 ? "03/PAG" : "03/VER 34",bgcolor=shade,text_color=color.aqua,text_size=size.tiny)
    table.cell(board,5,infoRow,"NO LIVE",bgcolor=shade,text_color=color.gray,text_size=size.tiny)
