s09 = input.symbol("IC:AUDUSD", "AUDUSD", group="Activos 1")
s10 = input.symbol("IC:USDCAD", "USDCAD", group="Activos 1")
s11 = input.symbol("IC:USDJPY", "USDJPY", group="Activos 1")
